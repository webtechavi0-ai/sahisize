---
/**
 * Base layout (PLAN 2 C): <head> with SEO tags, font preload, theme pre-paint script,
 * PWA manifest; header/footer; analytics and service-worker registration.
 */
import { pwaInfo } from 'virtual:pwa-info';
import '@/styles/global.css';
import {
  HTML_LANG,
  THEME_COLOR,
  THEME_COLOR_DARK,
  absoluteUrl,
  type Lang,
} from '@/config/site';
import { t } from '@/i18n';
import SeoHead from '@/components/site/SeoHead.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import type { Alternates } from '@/seo/hreflang';
import type { JsonLd } from '@/seo/jsonld';

export interface BaseProps {
  title: string;
  description: string;
  lang?: Lang;
  /** Path for the canonical URL, e.g. "/exam/ibps-po". Defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** en/hi counterparts for hreflang and the language toggle. */
  alternates?: Alternates;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: (JsonLd | null | undefined)[];
  /** 'minimal' drops header/footer (kit flow, SPEC 6.4). */
  chrome?: 'full' | 'minimal';
  hideSearch?: boolean;
  /** Extra classes for <main>. */
  mainClass?: string;
}
type Props = BaseProps;

const {
  title,
  description,
  lang = 'en',
  canonicalPath,
  noindex = false,
  alternates,
  ogImage,
  ogType,
  jsonLd,
  chrome = 'full',
  hideSearch = false,
  mainClass = 'mx-auto w-full max-w-5xl flex-1 px-4 py-6',
} = Astro.props;

function normalize(p: string): string {
  const s = p.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
  return s || '/';
}
const path = normalize(canonicalPath ?? Astro.url.pathname);
const canonical = absoluteUrl(path === '/' ? '/' : path);
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      noindex={noindex}
      alternates={alternates}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content={THEME_COLOR} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <!--
      Pre-paint theme: localStorage 'sahisize:theme' = 'light' | 'dark' (manual choice);
      otherwise follow the OS. Always writes the RESOLVED value to <html data-theme>
      so Tailwind `dark:` variants work; CSS also falls back to prefers-color-scheme.
    -->
    <script is:inline>
      (function () {
        try {
          const s = localStorage.getItem('sahisize:theme');
          const d =
            s === 'dark' || (s !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', d ? 'dark' : 'light');
        } catch {
          /* storage blocked: CSS prefers-color-scheme fallback applies */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only-focusable absolute left-2 top-2 z-50 rounded-card bg-surface p-3"
    >
      {t(lang, 'common.skipToContent')}
    </a>
    {chrome === 'full' && <Header lang={lang} alternates={alternates} hideSearch={hideSearch} />}
    <slot name="top" />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    {chrome === 'full' && <Footer lang={lang} />}
    <script>
      import { registerSW } from 'virtual:pwa-register';
      import { initAnalytics, initPromoTracking } from '@/scripts/analytics-init';
      import { track } from '@/lib/analytics';
      initAnalytics();
      initPromoTracking(track);
      registerSW({ immediate: true });
    </script>
  </body>
</html>
