---
/**
 * Base layout (PLAN 2 C): <head> with SEO tags, font preload, theme pre-paint script,
 * PWA manifest; header/footer; analytics and service-worker registration.
 */
import { pwaInfo } from 'virtual:pwa-info';
import '@/styles/global.css';
import {
  HTML_LANG,
  THEME_COLOR,
  THEME_COLOR_DARK,
  absoluteUrl,
  type Lang,
} from '@/config/site';
import { t } from '@/i18n';
import SeoHead from '@/components/site/SeoHead.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import type { Alternates } from '@/seo/hreflang';
import type { JsonLd } from '@/seo/jsonld';

export interface BaseProps {
  title: string;
  description: string;
  lang?: Lang;
  /** Path for the canonical URL, e.g. "/exam/ibps-po". Defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** en/hi counterparts for hreflang and the language toggle. */
  alternates?: Alternates;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: (JsonLd | null | undefined)[];
  /** 'minimal' drops header/footer (kit flow, SPEC 6.4). */
  chrome?: 'full' | 'minimal';
  hideSearch?: boolean;
  /** Extra classes for <main>. */
  mainClass?: string;
}
type Props = BaseProps;

const {
  title,
  description,
  lang = 'en',
  canonicalPath,
  noindex = false,
  alternates,
  ogImage,
  ogType,
  jsonLd,
  chrome = 'full',
  hideSearch = false,
  mainClass = 'container-fluid flex-1 py-6',
} = Astro.props;

function normalize(p: string): string {
  const s = p.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
  return s || '/';
}
const path = normalize(canonicalPath ?? Astro.url.pathname);
const canonical = absoluteUrl(path === '/' ? '/' : path);
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      noindex={noindex}
      alternates={alternates}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content={THEME_COLOR} data-light={THEME_COLOR} data-dark={THEME_COLOR_DARK} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <!--
      Pre-paint theme: LIGHT BY DEFAULT. Only a stored manual choice
      (localStorage 'sahisize:theme' = 'dark') selects dark; the OS preference is ignored.
      Writes the resolved value to <html data-theme> before first paint, so nothing flashes.
      Astro's experimental.csp hashes this inline script at build time (PLAN 3.12).
    -->
    <script is:inline>
      (function () {
        let d = false;
        const r = document.documentElement;
        try {
          d = localStorage.getItem('sahisize:theme') === 'dark';
          // Home ExamPilot banner dismissed before (key = EXAMPILOT.dismissKey, monetization.ts).
          if (localStorage.getItem('sahisize:promo:exampilot:dismissed'))
            r.setAttribute('data-exampilot-dismissed', '');
        } catch {
          /* storage blocked: light, banner shown */
        }
        r.setAttribute('data-theme', d ? 'dark' : 'light');
        if (d) {
          const m = document.querySelector('meta[name="theme-color"]');
          if (m && m.dataset.dark) m.setAttribute('content', m.dataset.dark);
        }
      })();
    </script>
    <!-- Google tag (gtag.js); origins allowed in src/config/csp.ts (ANALYTICS_ORIGINS). -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HWMGBKFKK9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // gtag.js needs the real Arguments object, not a rest array.
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-HWMGBKFKK9');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen-safe flex flex-col">
    <a
      href="#main"
      class="sr-only-focusable absolute left-2 top-2 z-50 rounded-card bg-card p-3"
    >
      {t(lang, 'common.skipToContent')}
    </a>
    {chrome === 'full' && <Header lang={lang} alternates={alternates} hideSearch={hideSearch} />}
    <slot name="top" />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    {chrome === 'full' && <Footer lang={lang} />}
    <script>
      import { registerSW } from 'virtual:pwa-register';
      import { initAnalytics, initPromoTracking } from '@/scripts/analytics-init';
      import { track } from '@/lib/analytics';
      initAnalytics();
      initPromoTracking(track);
      registerSW({ immediate: true });
    </script>
  </body>
</html>
