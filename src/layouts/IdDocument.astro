---
/**
 * Govt ID Documents spec page (/id-documents/*). Like the Tool layout, but:
 *  - its own breadcrumb (Home › Govt ID Documents › page), never under /tools or /exams
 *  - the disclaimer near the top and again at the foot (owner rule 4)
 *  - the official spec table with source links and checked date right after the tool
 *  - no exam links, no sponsored promo, and no header exam search (no free-text field at all)
 * JSON-LD: BreadcrumbList, WebApplication, HowTo, FAQPage (no government types).
 */
import Base from './Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import FaqList from '@/components/site/FaqList.astro';
import IdDisclaimer from '@/components/id-documents/IdDisclaimer.astro';
import IdSpecTable from '@/components/id-documents/IdSpecTable.astro';
import { t, localizePath } from '@/i18n';
import type { Lang } from '@/config/site';
import { ID_HUB, ID_PAGES, type IdDocPage } from '@/config/id-documents';
import type { IdCopy } from '@/components/id-documents/copy';
import { breadcrumbList, faqPage, howTo, webApplication } from '@/seo/jsonld';

interface Props {
  lang?: Lang;
  page: IdDocPage;
  copy: IdCopy;
}
const { lang = 'en', page, copy: c } = Astro.props;
const tr = (k: string) => t(lang, k);
const path = lang === 'hi' && page.hiPath ? page.hiPath : page.path;
const hubPath = ID_HUB[lang];
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: localizePath('/', lang) },
  { name: tr('site.footer.idDocuments'), path: hubPath },
  { name: c.h1, path },
];
const others = ID_PAGES.filter((p) => p.slug !== page.slug);
---

<Base
  title={c.title}
  description={c.description}
  lang={lang}
  canonicalPath={path}
  alternates={{ en: page.path, hi: page.hiPath }}
  ogImage="/og/default.png"
  hideSearch
  jsonLd={[
    breadcrumbList(crumbs),
    webApplication({ name: c.h1, description: c.description, path, lang }),
    c.steps.length ? howTo({ name: c.h1, description: c.description, steps: c.steps }) : null,
    faqPage(c.faq),
  ]}
>
  <div class="min-w-0" data-id-page={page.slug}>
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <h1 class="text-2xl font-bold leading-tight sm:text-3xl lg:text-4xl">{c.h1}</h1>
    <p class="mt-2 max-w-3xl text-lg">{c.intro}</p>
    <IdDisclaimer lang={lang} place="top" />

    <section class="mt-6" data-tool-slot={page.slug}>
      <slot />
    </section>

    <div class="max-w-4xl">
      <IdSpecTable lang={lang} page={page} />
      <slot name="content" />

      {
        c.steps.length > 0 && (
          <section aria-labelledby="how-h" class="mt-10">
            <h2 id="how-h" class="text-xl font-bold">{tr('site.tool.howTitle')}</h2>
            <ol class="mt-3 list-decimal space-y-2 pl-6">
              {c.steps.map((s) => (
                <li>
                  <strong>{s.name}.</strong> {s.text}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <FaqList title={tr('site.tool.faqTitle')} items={c.faq} />

      <nav aria-labelledby="id-more-h" class="mt-10">
        <h2 id="id-more-h" class="text-xl font-bold">{tr('site.footer.idDocuments')}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            others.map((p) => (
              <li>
                <a
                  href={lang === 'hi' && p.hiPath ? p.hiPath : p.path}
                  class="inline-flex min-h-tap items-center rounded-xl border border-rule bg-card px-4 no-underline hover:border-saffron"
                >
                  {p.spec.label[lang]}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={hubPath}
              class="inline-flex min-h-tap items-center rounded-xl border border-rule bg-card px-4 no-underline hover:border-saffron"
            >
              {lang === 'hi' ? 'सभी साइज़ और सोर्स' : 'All sizes and sources'}
            </a>
          </li>
        </ul>
      </nav>

      <IdDisclaimer lang={lang} place="bottom" />
    </div>
  </div>
</Base>
