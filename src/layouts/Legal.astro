---
/** Legal and trust pages (SPEC 11.2): about, privacy, terms, disclaimer, contact. English only. */
import Base from './Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import { breadcrumbList } from '@/seo/jsonld';
import { withSiteName } from '@/seo/meta';
interface Props {
  title: string;
  description: string;
  path: string;
  updated?: string;
}
const { title, description, path, updated } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: title, path },
];
---

<Base
  title={withSiteName(title)}
  description={description}
  canonicalPath={path}
  alternates={{ en: path, hi: null }}
  jsonLd={[breadcrumbList(crumbs)]}
>
  <Breadcrumbs lang="en" crumbs={crumbs} />
  <article class="prose max-w-3xl dark:prose-invert prose-a:text-primary">
    <h1>{title}</h1>
    {updated && <p class="text-sm text-muted">Last updated: {updated}</p>}
    <slot />
  </article>
</Base>
