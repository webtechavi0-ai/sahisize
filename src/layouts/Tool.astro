---
/**
 * Tool page template (SPEC 6.5). Workstream F fills it in Phase 3:
 *  - default slot  -> the tool island (upload -> settings -> result, PassCheck)
 *  - slot "content" -> spec explanation / how-to prose below the tool (SEO)
 * The layout adds: H1 + intro, trust line, how-to steps, FAQ, links to the top exams
 * that use the tool (SPEC 9.1), the promo slot AFTER the tool, and JSON-LD
 * (WebApplication + HowTo + FAQPage + BreadcrumbList).
 */
import Base from './Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import FaqList from '@/components/site/FaqList.astro';
import PromoSlot from '@/components/site/PromoSlot.astro';
import Icon from '@/components/site/Icon.astro';
import { t, localizePath } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ToolSlug } from '@/config/tools';
import type { DocType } from '@/engine/types';
import { getKitDocuments, getSeasonOrder } from '@/content/presets';
import { breadcrumbList, faqPage, howTo, webApplication } from '@/seo/jsonld';
import { hindiExamSlugs, hindiToolPath } from '@/seo/hreflang';
import { ogPathFor } from '@/seo/og-image';

export interface ToolLayoutProps {
  lang?: Lang;
  tool: ToolSlug;
  /** English path of this page, e.g. "/tools/compress-image-to-20kb". */
  path: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  steps?: { name: string; text: string }[];
  faq?: { q: string; a: string }[];
  /** custom-preset pages are noindex (SPEC 9.1). */
  noindex?: boolean;
}
type Props = ToolLayoutProps;
const {
  lang = 'en',
  tool,
  path: enPath,
  title,
  description,
  h1,
  intro,
  steps = [],
  faq = [],
  noindex = false,
} = Astro.props;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const hiPath = hindiToolPath(enPath);
const path = lang === 'hi' && hiPath ? hiPath : enPath;

const DOCS_FOR_TOOL: Partial<Record<ToolSlug, DocType[]>> = {
  'compress-image': ['photo', 'signature', 'thumb'],
  'resize-image': ['photo'],
  'convert-image': ['photo'],
  'signature-resize': ['signature'],
  'thumb-impression': ['thumb'],
  'handwritten-declaration': ['declaration'],
  'images-to-pdf': ['certificate'],
  'compress-pdf': ['certificate'],
  'passport-photo-sheet': ['photo'],
  'batch-compress': ['photo'],
};
const docTypes = DOCS_FOR_TOOL[tool] ?? [];
const hiExams = new Set(hindiExamSlugs());
const exams = getSeasonOrder()
  .filter((p) => getKitDocuments(p).some((d) => docTypes.includes(d.doc)))
  .slice(0, 8);
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: localizePath('/', lang) },
  { name: tr('site.breadcrumb.tools'), path: '/tools' },
  { name: h1, path },
];
---

<Base
  title={title}
  description={description}
  lang={lang}
  canonicalPath={path}
  alternates={{ en: enPath, hi: hiPath }}
  ogImage={ogPathFor(enPath)}
  noindex={noindex}
  jsonLd={[
    breadcrumbList(crumbs),
    webApplication({ name: h1, description, path, lang }),
    steps.length ? howTo({ name: h1, description, steps }) : null,
    faqPage(faq),
  ]}
>
  <Breadcrumbs lang={lang} crumbs={crumbs} />
  <h1 class="text-2xl font-bold leading-tight sm:text-3xl">{h1}</h1>
  <p class="mt-2 text-lg">{intro}</p>
  <p class="mt-2 flex items-center gap-2 text-sm text-success-text">
    <Icon name="shield" size={18} />
    {t(lang, 'common.trustLine')}
  </p>

  <section class="mt-6" data-tool-slot={tool}>
    <slot>
      <div class="card p-6 text-center text-muted">{tr('site.tool.placeholder')}</div>
    </slot>
  </section>

  <PromoSlot lang={lang} placement="tool" />

  <slot name="content" />

  {
    steps.length > 0 && (
      <section aria-labelledby="how-h" class="mt-10">
        <h2 id="how-h" class="text-xl font-bold">{tr('site.tool.howTitle')}</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-6">
          {steps.map((s) => (
            <li>
              <strong>{s.name}.</strong> {s.text}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <FaqList title={tr('site.tool.faqTitle')} items={faq} />

  {
    exams.length > 0 && (
      <section aria-labelledby="tex-h" class="mt-10">
        <h2 id="tex-h" class="text-xl font-bold">{tr('site.tool.topExams')}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {exams.map((p) => (
            <li>
              <a
                href={lang === 'hi' && hiExams.has(p.slug) ? `/hi/exam/${p.slug}` : `/exam/${p.slug}`}
                class="inline-flex min-h-tap items-center rounded-card border border-border bg-surface px-4 no-underline hover:border-primary"
              >
                {p.name[lang]}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <p class="mt-8">
    <a href="/tools" class="font-semibold">{tr('site.tool.allTools')}</a>
  </p>
</Base>
