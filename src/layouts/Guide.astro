---
/** Guide article layout (SPEC 9.5) with Article + BreadcrumbList JSON-LD. */
import Base from './Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import PromoSlot from '@/components/site/PromoSlot.astro';
import { t, localizePath } from '@/i18n';
import type { Lang } from '@/config/site';
import { getPreset } from '@/content/presets';
import { TOOLS } from '@/config/tools';
import { article, breadcrumbList } from '@/seo/jsonld';
import { hindiExamSlugs } from '@/seo/hreflang';
import { ogPathFor } from '@/seo/og-image';
import { formatDate } from '@/seo/spec-text';
import { toolNameKey } from '@/components/site/util';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  updatedAt?: Date;
  relatedExams: string[];
  relatedTools: string[];
  /** Whether the other-language version exists. */
  hasCounterpart: boolean;
}
const { lang, title, description, slug, publishedAt, updatedAt, relatedExams, relatedTools, hasCounterpart } =
  Astro.props;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const enPath = `/guides/${slug}`;
const path = localizePath(enPath, lang);
const alternates =
  lang === 'hi'
    ? { en: hasCounterpart ? enPath : '/guides', hi: path }
    : { en: enPath, hi: hasCounterpart ? `/hi${enPath}` : null };
// A Hindi guide without an English twin still needs a valid toggle target, but no hreflang.
const hreflangAlt = hasCounterpart ? { en: enPath, hi: `/hi${enPath}` } : { en: alternates.en, hi: null };
const iso = (d: Date) => d.toISOString().slice(0, 10);
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: localizePath('/', lang) },
  { name: tr('site.breadcrumb.guides'), path: localizePath('/guides', lang) },
  { name: title, path },
];
const hiExams = new Set(hindiExamSlugs());
const exams = relatedExams
  .map((s) => getPreset(s))
  .filter((p) => p && p.published)
  .map((p) => ({ name: p!.name[lang], href: lang === 'hi' && hiExams.has(p!.slug) ? `/hi/exam/${p!.slug}` : `/exam/${p!.slug}` }));
const tools = TOOLS.filter((x) => relatedTools.includes(x.slug));
---

<Base
  title={`${title} | SahiSize`}
  description={description}
  lang={lang}
  canonicalPath={path}
  alternates={lang === 'hi' ? { ...hreflangAlt, en: alternates.en } : hreflangAlt}
  ogImage={ogPathFor(enPath)}
  ogType="article"
  jsonLd={[
    breadcrumbList(crumbs),
    article({ title, description, path, publishedAt, updatedAt, lang, image: ogPathFor(enPath) }),
  ]}
>
  <Breadcrumbs lang={lang} crumbs={crumbs} />
  <article>
    <header>
      <h1 class="text-3xl font-bold leading-tight">{title}</h1>
      <p class="mt-2 text-sm text-muted">
        <time datetime={iso(updatedAt ?? publishedAt)}>
          {updatedAt
            ? tr('site.guides.updated', { date: formatDate(iso(updatedAt), lang) })
            : tr('site.guides.published', { date: formatDate(iso(publishedAt), lang) })}
        </time>
      </p>
    </header>
    <div class="prose prose-lg mt-6 max-w-none dark:prose-invert prose-a:text-primary">
      <slot />
    </div>
  </article>
  {
    (exams.length > 0 || tools.length > 0) && (
      <aside class="mt-10 grid gap-6 sm:grid-cols-2">
        {exams.length > 0 && (
          <section>
            <h2 class="text-lg font-bold">{tr('site.guides.relatedExams')}</h2>
            <ul class="mt-2 space-y-1">
              {exams.map((e) => (
                <li><a class="inline-flex min-h-[40px] items-center" href={e.href}>{e.name}</a></li>
              ))}
            </ul>
          </section>
        )}
        {tools.length > 0 && (
          <section>
            <h2 class="text-lg font-bold">{tr('site.guides.relatedTools')}</h2>
            <ul class="mt-2 space-y-1">
              {tools.map((x) => (
                <li><a class="inline-flex min-h-[40px] items-center" href={x.path}>{tr(toolNameKey(x.slug))}</a></li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    )
  }
  <PromoSlot lang={lang} placement="guide" />
</Base>
