---
/**
 * Exam page template (SPEC 6.3), used by /exam/[slug] and /hi/exam/[slug].
 * Action first: H1, then one big "Make my files" button (opens the kit at its first
 * document) with a compact "What you'll need" list (each row opens that document's page).
 * The reference content follows, still crawlable: intro, notice badge, live-capture
 * notice, spec table, rejection tips, declaration text, per-exam copy, FAQ, tools,
 * related exams, promo (after the tool, never inside it).
 * All content comes from the preset (Workstream D) — nothing is spun.
 */
import Base from './Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import NoticeBadge from '@/components/site/NoticeBadge.astro';
import SpecTable from '@/components/site/SpecTable.astro';
import LiveCaptureTips from '@/components/site/LiveCaptureTips.astro';
import RejectionTips from '@/components/site/RejectionTips.astro';
import DeclarationText from '@/components/site/DeclarationText.astro';
import ExamCopy from '@/components/site/ExamCopy.astro';
import FaqList from '@/components/site/FaqList.astro';
import RelatedExams from '@/components/site/RelatedExams.astro';
import PromoSlot from '@/components/site/PromoSlot.astro';
import AffiliateSlot from '@/components/site/AffiliateSlot.astro';
import Icon from '@/components/site/Icon.astro';
import Feedback from '@/components/site/Feedback.astro';
import { t, localizePath } from '@/i18n';
import { plural } from '@/i18n/core';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
import { docSlug, getKitDocuments } from '@/content/presets';
import { examH1, examMeta } from '@/seo/meta';
import { examSeo } from '@/seo/exam-seo';
import { familyOf, hubPath } from '@/seo/families';
import { breadcrumbList, faqPage, howTo } from '@/seo/jsonld';
import { hasHindiExam } from '@/seo/hreflang';
import { ogPathFor } from '@/seo/og-image';
import { toolsForExam } from '@/seo/exam-links';
import { localHref } from '@/seo/localize-href';
import { toolNameKey } from '@/components/site/util';
import { docSummary, kbText, lowerLabel } from '@/seo/spec-text';

interface Props {
  lang: Lang;
  preset: ExamPreset;
}
const { lang, preset: p } = Astro.props;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);

const enPath = `/exam/${p.slug}`;
const hasHi = hasHindiExam(p.slug);
const alternates = { en: enPath, hi: hasHi ? `/hi${enPath}` : null };
const path = lang === 'hi' ? `/hi${enPath}` : enPath;
const kitHref = lang === 'hi' && hasHi ? `/hi/kit/${p.slug}` : `/kit/${p.slug}`;
const kitDocs = getKitDocuments(p);
const meta = examMeta(p, lang);
const h1 = examH1(p, lang);
// Keyword copy (src/seo/exam-seo.ts) is English-only.
const seo = lang === 'en' ? examSeo(p.slug) : undefined;
const faqItems = [...p.faq.map((f) => ({ q: f.q[lang], a: f.a[lang] })), ...(seo?.faq ?? [])];
// Exam-family hub (English only): breadcrumb level and "All SSC exams" link.
const family = familyOf(p);
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: localizePath('/', lang) },
  { name: tr('site.breadcrumb.exams'), path: localizePath('/exams', lang) },
  ...(family && lang === 'en' ? [{ name: tr('site.hub.crumb', { family: family.name }), path: hubPath(family) }] : []),
  { name: p.name[lang], path },
];
const tools = toolsForExam(p);
const jsonLd = [
  breadcrumbList(crumbs),
  howTo({
    name: h1,
    description: meta.description,
    totalTimeIso: 'PT3M',
    steps: [
      {
        name: lang === 'hi' ? 'किट खोलें' : 'Open the kit',
        text: plural(tr, 'site.exam.startKit', kitDocs.length),
        path: kitHref,
      },
      ...kitDocs.map((d) => ({
        name: d.label[lang],
        text: `${d.label[lang]}: ${docSummary(d, lang)}. ${d.rules[0]?.[lang] ?? ''}`.trim(),
      })),
      {
        name: lang === 'hi' ? 'ZIP डाउनलोड करें' : 'Download all as ZIP',
        text:
          lang === 'hi'
            ? 'हर नियम पर टिक दिखने के बाद सभी फाइल एक ZIP में डाउनलोड करें।'
            : 'When every rule shows a tick, download all files as one ZIP.',
      },
    ],
  }),
  faqPage(faqItems),
];
---

<Base
  title={meta.title}
  description={meta.description}
  lang={lang}
  canonicalPath={path}
  alternates={alternates}
  ogImage={ogPathFor(enPath)}
  jsonLd={jsonLd}
>
  <Feedback lang={lang} />
  <Breadcrumbs lang={lang} crumbs={crumbs} />
  <h1 class="text-2xl font-bold leading-tight text-text sm:text-3xl">{h1}</h1>

  {
    kitDocs.length > 0 && (
      <section class="card mt-4 max-w-xl p-4" aria-labelledby="need-h" data-exam-start>
        <a
          href={`${kitHref}#start`}
          class="btn-action min-h-[56px] w-full text-lg"
          data-exam-select={p.slug}
        >
          {kitDocs.length === 1
            ? tr('site.exam.ctaOne', {
                exam: p.name[lang],
                doc: lang === 'en' ? lowerLabel(kitDocs[0]!.label.en) : kitDocs[0]!.label[lang],
              })
            : tr('site.exam.cta', { exam: p.name[lang] })}
          <Icon name="arrowRight" size={20} />
        </a>
        <p class="mt-2 text-center text-sm text-muted">
          {tr('site.exam.ctaNote', { min: Math.max(1, kitDocs.length) })}
        </p>
        <h2 id="need-h" class="mt-4 font-bold">
          {tr('site.exam.needTitle')}
        </h2>
        <ul class="mt-1 divide-y divide-border">
          {kitDocs.map((d, i) => (
            <li>
              <a
                href={`${enPath}/${docSlug(d)}`}
                class="flex min-h-tap items-center gap-3 py-2 text-text no-underline hover:text-primary"
              >
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-saffron-soft text-sm font-bold text-ink"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold">{d.label[lang]}</span>
                  <span class="block text-sm text-muted">
                    {[kbText(d, lang), d.format.toUpperCase()].filter(Boolean).join(' · ')}
                  </span>
                </span>
                <Icon name="arrowRight" size={18} class="shrink-0 text-muted" />
              </a>
            </li>
          ))}
          {p.photoUploadReplacedByLive && (
            <li class="flex items-start gap-3 py-3 text-sm">
              <Icon name="camera" size={20} class="mt-0.5 shrink-0 text-primary" />
              <span>
                {tr('site.exam.liveShort')}{' '}
                <a href="#live-h" class="font-semibold">
                  {tr('site.exam.liveShortLink')}
                </a>
              </span>
            </li>
          )}
        </ul>
        {kitDocs.length > 1 && <p class="mt-1 text-sm text-muted">{tr('site.exam.needOnly')}</p>}
      </section>
    )
  }

  {seo?.intro && <p class="mt-6 max-w-3xl text-lg">{seo.intro}</p>}
  <div class="mt-3">
    <NoticeBadge lang={lang} preset={p} />
  </div>

  <LiveCaptureTips lang={lang} preset={p} />

  <section aria-labelledby="spec-h" class="mt-6">
    <h2 id="spec-h" class="mb-3 text-xl font-bold">{seo?.specH2 ?? tr('site.exam.specTitle')}</h2>
    <SpecTable lang={lang} preset={p} docBase={enPath} />
  </section>

  <RejectionTips lang={lang} preset={p} />
  <DeclarationText lang={lang} preset={p} />
  <ExamCopy lang={lang} slug={p.slug} title={seo?.aboutH2 ?? tr('site.exam.aboutTitle', { exam: p.name[lang] })} />
  <FaqList title={seo?.faqH2 ?? tr('site.exam.faqTitle', { exam: p.name[lang] })} items={faqItems} />

  <section aria-labelledby="tools-h" class="mt-10">
    <h2 id="tools-h" class="text-xl font-bold">{tr('site.exam.toolsTitle')}</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        tools.map((x) => (
          <li>
            <a
              href={localHref(x.path, lang)}
              class="inline-flex min-h-tap items-center rounded-card border border-border bg-surface px-4 no-underline hover:border-primary"
            >
              {x.kb ? tr('site.home.compressTo', { n: x.kb }) : tr(toolNameKey(x.slug))}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    family && (
      <p class="mt-10">
        <a href={hubPath(family)} class="inline-flex min-h-tap items-center gap-1 font-semibold">
          {tr('site.hub.allFamily', { family: family.name })}
          <Icon name="arrowRight" size={18} />
        </a>
      </p>
    )
  }
  <RelatedExams lang={lang} preset={p} />
  <PromoSlot lang={lang} placement="exam" exam={p.slug} group={p.group} />
  <AffiliateSlot lang={lang} placement="exam" exam={p.slug} group={p.group} />
</Base>
<script>
  import { track } from '@/lib/analytics';
  document.querySelectorAll<HTMLAnchorElement>('a[data-exam-select]').forEach((a) =>
    a.addEventListener('click', () => track('exam_selected', { exam: a.dataset.examSelect!, source: 'link' })),
  );
</script>
