---
/**
 * Official spec table for one /id-documents page (owner rule 2): the values exactly as
 * published, how we read them in pixels, the source links and the checked date.
 */
import type { Lang } from '@/config/site';
import { ID_CHECKED_LABEL, ID_CHECKED_ON, type IdDocPage } from '@/config/id-documents';
interface Props {
  lang: Lang;
  page: IdDocPage;
}
const { lang, page } = Astro.props;
const s = page.spec;
const o = page.official;
const hi = lang === 'hi';
const L = hi
  ? {
      title: 'आधिकारिक साइज़ और सोर्स',
      caption: 'Protean गाइडलाइन में लिखे नियम और हमारा पिक्सेल साइज़',
      rule: 'नियम',
      published: 'गाइडलाइन में लिखा',
      ours: 'टूल क्या बनाता है',
      dim: 'माप',
      dpi: 'रेज़ोल्यूशन',
      type: 'टाइप',
      file: 'फाइल टाइप',
      size: 'साइज़',
      max: 'अधिकतम',
      wide: 'चौड़ा',
      tall: 'ऊँचा',
      under: 'से कम',
      colour: 'रंगीन',
      source: 'सोर्स',
      quote: 'पेज पर लिखा टेक्स्ट',
    }
  : {
      title: 'Official size and source',
      caption: 'Rules as published in the Protean guideline, and the pixel size we make',
      rule: 'Rule',
      published: 'Published',
      ours: 'What the tool makes',
      dim: 'Dimension',
      dpi: 'Resolution',
      type: 'Type',
      file: 'File type',
      size: 'Size',
      max: 'Max.',
      wide: 'wide',
      tall: 'tall',
      under: 'under',
      colour: 'Colour JPEG',
      source: 'Source',
      quote: 'Text on the page',
    };
const phys = s.physical!;
const rows: [string, string, string][] = [
  [L.dim, o.dimension, `${phys.width} cm ${L.wide} × ${phys.height} cm ${L.tall} = ${s.widthPx}×${s.heightPx} px`],
  [L.dpi, `${o.dpi} DPI`, `${s.dpi} DPI`],
  [L.type, o.type, hi ? 'रंगीन JPEG' : L.colour],
  [L.file, o.fileType, 'JPEG (.jpg)'],
  [L.size, `${L.max} ${o.maxKB} KB`, hi ? `${o.maxKB} KB ${L.under}` : `${L.under} ${o.maxKB} KB`],
];
---

<section aria-labelledby="id-spec-h" class="mt-10" data-id-spec>
  <h2 id="id-spec-h" class="text-xl font-bold">{L.title}</h2>
  <div class="mt-3 overflow-x-auto rounded-card border border-border bg-surface">
    <table class="w-full border-collapse text-left text-sm">
      <caption class="sr-only">{L.caption}</caption>
      <thead class="bg-bg text-muted">
        <tr>
          <th scope="col" class="px-3 py-2 font-semibold">{L.rule}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{L.published}</th>
          <th scope="col" class="px-3 py-2 font-semibold">{L.ours}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(([k, a, b]) => (
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-2 font-semibold">{k}</th>
              <td class="px-3 py-2" lang="en">{a}</td>
              <td class="px-3 py-2">{b}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="mt-3 space-y-2 text-sm">
    <p>
      <span class="font-semibold">{L.source}:</span>
      {
        page.sources.map((src, i) => (
          <>
            {i > 0 && ' · '}
            <a href={src.url} rel="noopener" target="_blank" lang="en" data-id-source>
              {src.body}: {src.title}
            </a>
          </>
        ))
      }
    </p>
    <p class="font-semibold" data-id-checked>
      <time datetime={ID_CHECKED_ON}>{ID_CHECKED_LABEL[lang]}</time>
      {hi && <span lang="en" class="font-normal text-muted"> (Checked on 22 Oct 2026)</span>}
    </p>
    <blockquote class="border-l-4 border-rule pl-3 text-muted" lang="en">
      <span class="sr-only">{L.quote}: </span>“{page.sources[0]!.quote}”
    </blockquote>
  </div>
</section>
