---
/**
 * SEO prose below a tool (SPEC 6.5, 9.4): spec explanation sections. Steps and FAQ are
 * rendered by C's Tool layout from the same copy object.
 */
import type { ToolSection } from './copy/types';
interface Props {
  sections: ToolSection[];
}
const { sections } = Astro.props;
---

{
  sections.map((s, i) => (
    <section aria-labelledby={`tc-${i}`} class="mt-10">
      <h2 id={`tc-${i}`} class="text-xl font-bold">
        {s.h2}
      </h2>
      {s.paras.map((p) => (
        <p class="mt-3">{p}</p>
      ))}
      {s.list && (
        <ul class="mt-3 list-disc space-y-1 pl-6">
          {s.list.map((li) => (
            <li>{li}</li>
          ))}
        </ul>
      )}
      {s.links && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {s.links.map((l) => (
            <li>
              <a
                href={l.href}
                class="inline-flex min-h-tap items-center rounded-card border border-border bg-surface px-4 no-underline hover:border-primary"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}
