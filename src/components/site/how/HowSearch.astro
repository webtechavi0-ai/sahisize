---
/** How it works, step 1: exam search with "IBPS PO" typed and the match highlighted. Static SVG, no JS. */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<svg viewBox="0 0 240 120" role="img" aria-labelledby="how-art-1" class="h-full w-full" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" font-family="inherit">
  <title id="how-art-1">{title}</title>
  <rect x="20" y="13" width="200" height="36" rx="12" class="fill-card stroke-ink" />
  <circle cx="39" cy="29" r="6" class="stroke-ink" />
  <path d="M43.5 33.5l4 4" class="stroke-ink" />
  <text x="56" y="36" font-size="15" font-weight="700" class="fill-ink">IBPS PO</text>
  <path d="M121 23v13" class="stroke-saffron" />
  <rect x="20" y="57" width="200" height="54" rx="12" class="fill-card stroke-rule-strong" />
  <rect x="28" y="64" width="184" height="20" rx="10" class="fill-saffron" />
  <text x="40" y="78" font-size="11" font-weight="700" class="fill-on-saffron">IBPS PO</text>
  <path d="M190 74l4 4 7-8" class="stroke-on-saffron" />
  <rect x="40" y="94" width="64" height="6" rx="3" class="fill-rule" />
  <rect x="112" y="94" width="36" height="6" rx="3" class="fill-rule" />
</svg>
