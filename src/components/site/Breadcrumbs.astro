---
/** Visible breadcrumb trail. The matching BreadcrumbList JSON-LD is built by the page. */
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
import type { Crumb } from '@/seo/jsonld';
interface Props {
  lang: Lang;
  crumbs: Crumb[];
}
const { lang, crumbs } = Astro.props;
---

<nav aria-label={t(lang, 'site.breadcrumb.label')} class="mb-4 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-1">
    {
      crumbs.map((c, i) => (
        <li class="inline-flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">›</span>}
          {c.path && i < crumbs.length - 1 ? (
            <a href={c.path} class="inline-flex min-h-[32px] items-center text-muted hover:text-primary">
              {c.name}
            </a>
          ) : (
            <span aria-current="page">{c.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
