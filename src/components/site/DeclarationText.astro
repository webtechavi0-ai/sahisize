---
/** Handwritten declaration text (SPEC 6.3 #6), only for exams that need one. */
import Icon from './Icon.astro';
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
interface Props {
  lang: Lang;
  preset: ExamPreset;
}
const { lang, preset: p } = Astro.props;
const d = p.declarationText;
const needs = p.documents.some((x) => x.doc === 'declaration');
---

{
  d && needs && (
    <section aria-labelledby="decl-h" class="mt-10">
      <h2 id="decl-h" class="text-xl font-bold">{t(lang, 'site.exam.declarationTitle')}</h2>
      <p class="mt-1 text-muted">{t(lang, 'site.exam.declarationIntro')}</p>
      <blockquote class="card mt-3 border-l-4 border-l-primary p-4 font-serif text-lg leading-relaxed" lang="en">
        {d.en}
      </blockquote>
      {lang === 'hi' && d.hi && <p class="mt-2 text-sm text-muted">{d.hi}</p>}
      {d.toVerify && (
        <p class="mt-2 flex gap-2 text-sm text-muted">
          <Icon name="info" size={18} class="mt-0.5 shrink-0" />
          {t(lang, 'site.exam.declarationToVerify')}
        </p>
      )}
    </section>
  )
}
