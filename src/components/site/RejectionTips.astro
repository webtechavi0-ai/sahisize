---
/** Real portal error messages and their fixes (SPEC 6.3 #5, K16). */
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
interface Props {
  lang: Lang;
  preset: ExamPreset;
}
const { lang, preset: p } = Astro.props;
---

{
  p.rejectionTips.length > 0 && (
    <section aria-labelledby="rej-h" class="mt-10">
      <h2 id="rej-h" class="text-xl font-bold">{t(lang, 'site.exam.rejectionTitle')}</h2>
      <p class="mt-1 text-muted">{t(lang, 'site.exam.rejectionIntro', { exam: p.name[lang] })}</p>
      <dl class="mt-4 space-y-3">
        {p.rejectionTips.map((r) => (
          <div class="card p-4">
            <dt class="font-semibold">
              <span class="sr-only">{t(lang, 'site.exam.rejectionError')}: </span>
              <q class="font-mono text-error-text" lang="en">{r.error}</q>
            </dt>
            <dd class="mt-1">
              <span class="font-semibold">{t(lang, 'site.exam.rejectionFix')}:</span> {r.fix[lang]}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
