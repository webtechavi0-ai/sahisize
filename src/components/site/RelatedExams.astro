---
/** Related exams (SPEC 6.3 #8, 9.1 internal links). Only published presets. */
import ExamCard from './ExamCard.astro';
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
import { getPublishedPresets } from '@/content/presets';
import { localHref } from '@/seo/localize-href';
interface Props {
  lang: Lang;
  preset: ExamPreset;
}
const { lang, preset: p } = Astro.props;
const published = getPublishedPresets();
const bySlug = new Map(published.map((x) => [x.slug, x]));
let related = p.related.map((s) => bySlug.get(s)).filter((x): x is ExamPreset => !!x);
// Top up with same-group exams so every page links to at least 3 others.
if (related.length < 3) {
  for (const x of published) {
    if (related.length >= 4) break;
    if (x.slug !== p.slug && x.group === p.group && !related.includes(x)) related.push(x);
  }
}
related = related.slice(0, 6);
const href = (s: string) => localHref(`/exam/${s}`, lang);
---

{
  related.length > 0 && (
    <section aria-labelledby="rel-h" class="mt-10">
      <h2 id="rel-h" class="text-xl font-bold">{t(lang, 'site.exam.relatedTitle')}</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <ExamCard lang={lang} preset={r} href={href(r.slug)} />)}
      </ul>
    </section>
  )
}
