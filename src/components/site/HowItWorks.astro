---
import Icon from './Icon.astro';
import HowSearch from './how/HowSearch.astro';
import HowCrop from './how/HowCrop.astro';
import HowDownload from './how/HowDownload.astro';
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const steps = [
  { icon: 'search', n: 1, Art: HowSearch },
  { icon: 'crop', n: 2, Art: HowCrop },
  { icon: 'download', n: 3, Art: HowDownload },
] as const;
---

<section aria-labelledby="how-h" class="mt-12">
  <h2 id="how-h" class="text-xl font-bold">{t(lang, 'site.home.howTitle')}</h2>
  <ol class="mt-4 grid gap-3 sm:grid-cols-3">
    {
      steps.map(({ icon, n, Art }) => (
        <li class="card flex flex-col gap-4 p-4">
          {/* Fixed-height scene box: no layout shift, inline SVG, no JS. */}
          <div class="h-[120px] overflow-hidden rounded-2xl border border-rule bg-paper p-1 lg:h-[136px]">
            <Art title={t(lang, `site.how.step${n}Alt`)} />
          </div>
          <div class="flex gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary">
              <Icon name={icon} size={20} />
            </span>
            <span>
              <span class="block font-semibold">
                {n}. {t(lang, `site.home.how${n}Title`)}
              </span>
              <span class="block text-sm text-muted">{t(lang, `site.home.how${n}Text`)}</span>
            </span>
          </div>
        </li>
      ))
    }
  </ol>
</section>
