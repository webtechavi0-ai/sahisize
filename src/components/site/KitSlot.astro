---
/**
 * Mount point for B's KitFlow island (src/islands/KitFlow.tsx), per its mount contract.
 *  - /kit/[slug]: all fittable documents, client:load (the page IS the tool).
 *  - /exam/[slug]/[document]: pre-set to one document (`only`), client:visible.
 * The promo card goes in KitFlow's "promo" slot: shown under the summary only (SPEC 10).
 */
import KitFlow from '@/islands/KitFlow';
import PromoSlot from './PromoSlot.astro';
import { toKitPreset } from '@/components/kit/kit-preset';
import { getNamespace } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
import { hasHindiExam } from '@/seo/hreflang';
interface Props {
  lang: Lang;
  preset: ExamPreset;
  /** docSlug to pre-set the tool to a single document. */
  only?: string;
}
const { lang, preset: p, only } = Astro.props;
const examHref = lang === 'hi' && hasHindiExam(p.slug) ? `/hi/exam/${p.slug}` : `/exam/${p.slug}`;
const props = {
  preset: toKitPreset(p),
  lang,
  dict: getNamespace(lang, 'common', 'ui', 'kit'),
  examHref,
  // /report exists in English only.
  reportHref: '/report',
  showHeader: false,
  ...(only ? { only } : {}),
};
---

{
  only ? (
    <KitFlow client:visible {...props}>
      <PromoSlot slot="promo" lang={lang} placement="kit-summary" exam={p.slug} group={p.group} />
    </KitFlow>
  ) : (
    <KitFlow client:load {...props}>
      <PromoSlot slot="promo" lang={lang} placement="kit-summary" exam={p.slug} group={p.group} />
    </KitFlow>
  )
}
