---
/**
 * Footer (SPEC 6.1, 11.2): tools, top exams, guides, legal links,
 * "Not affiliated with any government body." and the operating entity.
 */
import { getCollection } from 'astro:content';
import { ENTITY_NAME, type Lang } from '@/config/site';
import { TOOLS } from '@/config/tools';
import { getSeasonOrder } from '@/content/presets';
import { t } from '@/i18n';
import { localHref } from '@/seo/localize-href';
import { toolNameKey } from './util';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);

const href = (enPath: string) => localHref(enPath, lang);
const topExams = getSeasonOrder().slice(0, 8);

const footerTools = TOOLS.filter((x) => x.slug !== 'custom-preset' && x.slug !== 'batch-compress').slice(0, 8);

const guides = (await getCollection('guides', (g) => g.data.lang === lang && !g.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const legal = [
  ['/about', 'site.footer.about'],
  ['/privacy', 'site.footer.privacy'],
  ['/terms', 'site.footer.terms'],
  ['/disclaimer', 'site.footer.disclaimer'],
  ['/contact', 'site.footer.contact'],
  ['/sources', 'site.footer.sources'],
  ['/editorial-policy', 'site.footer.editorialPolicy'],
  ['/report', 'site.footer.report'],
] as const;
const linkCls = 'inline-flex min-h-[48px] items-center text-text no-underline hover:text-primary hover:underline';
---

<footer class="mt-12 border-t border-border bg-surface">
  <div class="container-fluid grid gap-8 py-8 text-sm sm:grid-cols-2 lg:grid-cols-4">
    <section aria-labelledby="ft-tools">
      <h2 id="ft-tools" class="mb-2 font-semibold text-text">{tr('site.footer.tools')}</h2>
      <ul>
        {footerTools.map((tool) => (
          <li><a class={linkCls} href={href(tool.path)}>{tr(toolNameKey(tool.slug))}</a></li>
        ))}
        <li><a class={linkCls} href={localizePath('/id-documents', lang)}>{tr('site.footer.idDocuments')}</a></li>
      </ul>
    </section>
    <section aria-labelledby="ft-exams">
      <h2 id="ft-exams" class="mb-2 font-semibold text-text">{tr('site.footer.topExams')}</h2>
      <ul>
        {topExams.map((p) => (
          <li><a class={linkCls} href={href(`/exam/${p.slug}`)}>{p.name[lang]}</a></li>
        ))}
        <li><a class={linkCls} href={href('/exams')}>{tr('site.footer.allExams')}</a></li>
      </ul>
    </section>
    <section aria-labelledby="ft-guides">
      <h2 id="ft-guides" class="mb-2 font-semibold text-text">{tr('site.footer.guides')}</h2>
      <ul>
        {guides.map((g) => (
          <li><a class={linkCls} href={href(`/guides/${g.data.slug}`)}>{g.data.title}</a></li>
        ))}
        <li><a class={linkCls} href={href('/guides')}>{tr('site.footer.allGuides')}</a></li>
      </ul>
    </section>
    <section aria-labelledby="ft-legal">
      <h2 id="ft-legal" class="mb-2 font-semibold text-text">{tr('site.footer.legal')}</h2>
      <ul>
        {legal.map(([path, key]) => {
          const to = href(path);
          return <li><a class={linkCls} href={to} hreflang={lang === 'hi' && !to.startsWith('/hi') ? 'en-IN' : undefined}>{tr(key)}</a></li>;
        })}
      </ul>
    </section>
  </div>
  <div class="border-t border-border">
    <div class="container-fluid space-y-1 py-4 text-sm text-muted">
      <p>{tr('site.footer.notAffiliated')}</p>
      <p>
        {tr('site.footer.copyright', { year: new Date().getFullYear(), entity: ENTITY_NAME })} ·
        {tr('site.footer.operatedBy', { entity: ENTITY_NAME })}
      </p>
    </div>
  </div>
</footer>
