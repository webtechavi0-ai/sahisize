---
/** "Specs from IBPS CRP PO/MT-XVI notification · checked 12 Oct 2026 · Source" (SPEC 6.3 #2, 5.3). */
import Icon from './Icon.astro';
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
import { formatDate } from '@/seo/spec-text';
interface Props {
  lang: Lang;
  preset: ExamPreset;
}
const { lang, preset: p } = Astro.props;
---

<p class="inline-flex flex-wrap items-center gap-x-1 gap-y-0.5 rounded-card border border-border bg-surface px-3 py-2 text-sm text-muted">
  <Icon name="badge" size={18} class="shrink-0 text-success" />
  <span>
    {t(lang, 'site.exam.noticeBadge', {
      exam: p.body,
      notification: p.notification,
      date: formatDate(p.lastChecked, lang),
    })}
  </span>
  <a href={p.sourceUrl} rel="noopener nofollow external" target="_blank" class="font-semibold">
    {t(lang, 'site.exam.source')}{p.sourcePage ? ` (${t(lang, 'site.exam.sourcePage', { page: p.sourcePage })})` : ''}
  </a>
</p>
