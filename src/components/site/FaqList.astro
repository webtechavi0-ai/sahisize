---
/** FAQ as native <details> (no JS). FAQPage JSON-LD is built by the page. */
interface Props {
  title: string;
  items: { q: string; a: string }[];
  id?: string;
}
const { title, items, id = 'faq-h' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby={id} class="mt-10">
      <h2 id={id} class="text-xl font-bold">{title}</h2>
      <div class="mt-3 divide-y divide-border rounded-card border border-border bg-surface">
        {items.map((f) => (
          <details class="group px-4">
            <summary class="flex min-h-tap cursor-pointer list-none items-center justify-between gap-3 py-3 font-semibold [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span aria-hidden="true" class="text-muted transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="pb-4 text-text">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
