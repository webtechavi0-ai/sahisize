---
/**
 * Site header (SPEC 6.1): logo, exam search (icon on mobile that expands; inline on
 * wider screens), EN/हिं toggle, theme toggle. Search works without JS: it submits
 * to /exams?q=, which filters the list.
 */
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, localizePath } from '@/i18n';
import type { Lang } from '@/config/site';
import type { Alternates } from '@/seo/hreflang';
interface Props {
  lang: Lang;
  alternates?: Alternates;
  /** Hide the search (e.g. on the home page, which has the big search box). */
  hideSearch?: boolean;
}
const { lang, alternates, hideSearch = false } = Astro.props;
const home = localizePath('/', lang);
const examsHref = localizePath('/exams', lang);
const searchLabel = t(lang, 'site.header.searchLabel');
const placeholder = t(lang, 'site.header.searchPlaceholder');
---

<header class="relative border-b border-border bg-surface">
  <div class="mx-auto flex max-w-5xl items-center gap-1 px-4 py-1">
    <a
      href={home}
      class="mr-auto inline-flex min-h-tap items-center gap-2 font-bold no-underline"
      aria-label={t(lang, 'site.header.home')}
    >
      <img src="/icon.svg" width="32" height="32" alt="" />
      <span class="text-xl" lang="en"
        ><span class="text-saffron-text">Sahi</span><span class="text-primary">Size</span></span
      >
    </a>
    <nav aria-label={t(lang, 'site.header.nav')} class="hidden md:block">
      <ul class="flex items-center gap-1">
        <li>
          <a class="inline-flex min-h-tap items-center px-3 text-text no-underline hover:text-primary" href={examsHref}
            >{t(lang, 'site.header.exams')}</a
          >
        </li>
        <li>
          <a class="inline-flex min-h-tap items-center px-3 text-text no-underline hover:text-primary" href={localizePath('/guides', lang)}
            >{t(lang, 'site.header.guides')}</a
          >
        </li>
      </ul>
    </nav>
    {
      !hideSearch && (
        <>
          <form
            role="search"
            action={examsHref}
            method="get"
            class="hidden items-center sm:flex"
          >
            <label for="hdr-q" class="sr-only">
              {searchLabel}
            </label>
            <input
              id="hdr-q"
              name="q"
              type="search"
              autocomplete="off"
              enterkeyhint="search"
              placeholder={placeholder}
              class="h-10 w-56 rounded-card border border-border-strong bg-surface px-3 text-text placeholder:text-muted lg:w-72"
            />
            <button
              type="submit"
              class="ml-1 inline-flex h-tap w-tap items-center justify-center rounded-card text-text hover:bg-bg"
              aria-label={t(lang, 'site.header.searchSubmit')}
            >
              <Icon name="search" />
            </button>
          </form>
          <details class="group sm:hidden" data-header-search>
            <summary
              class="inline-flex h-tap w-tap cursor-pointer list-none items-center justify-center rounded-card text-text hover:bg-bg [&::-webkit-details-marker]:hidden"
              aria-label={t(lang, 'site.header.searchOpen')}
              title={t(lang, 'site.header.searchOpen')}
            >
              <Icon name="search" />
            </summary>
            <form
              role="search"
              action={examsHref}
              method="get"
              class="absolute inset-x-0 z-40 mt-1 flex gap-2 border-b border-border bg-surface px-4 py-3"
            >
              <label for="hdr-q-m" class="sr-only">
                {searchLabel}
              </label>
              <input
                id="hdr-q-m"
                name="q"
                type="search"
                autocomplete="off"
                enterkeyhint="search"
                placeholder={placeholder}
                class="h-tap min-w-0 flex-1 rounded-card border border-border-strong bg-surface px-3 text-text placeholder:text-muted"
              />
              <button type="submit" class="btn-action">
                {t(lang, 'site.header.searchSubmit')}
              </button>
            </form>
          </details>
        </>
      )
    }
    <LangToggle lang={lang} alternates={alternates} />
    <ThemeToggle lang={lang} />
  </div>
</header>
<script>
  // Focus the input when the mobile search expands.
  document.querySelectorAll<HTMLDetailsElement>('[data-header-search]').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) d.querySelector<HTMLInputElement>('input')?.focus();
    });
  });
</script>
