---
/**
 * Site header (SPEC 6.1): logo, exam search (B's ExamSearch island, `variant="header"`:
 * icon on mobile that expands, inline on wider screens), EN/हिं toggle, theme toggle.
 * Without JS the search form still submits to /exams?q= (desktop), which filters the list.
 */
import ExamSearch from '@/islands/ExamSearch';
import { getSearchIndex } from '@/content/presets';
import { hindiExamSlugs } from '@/seo/hreflang';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, localizePath, getNamespace } from '@/i18n';
import type { Lang } from '@/config/site';
import type { Alternates } from '@/seo/hreflang';
interface Props {
  lang: Lang;
  alternates?: Alternates;
  /** Hide the search (e.g. on the home page, which has the big search box). */
  hideSearch?: boolean;
}
const { lang, alternates, hideSearch = false } = Astro.props;
const home = localizePath('/', lang);
const examsHref = localizePath('/exams', lang);
const index = hideSearch ? [] : getSearchIndex();
const dict = getNamespace(lang, 'common', 'ui');
const hiSlugs = hindiExamSlugs();
---

<header class="relative border-b border-border bg-surface">
  <div class="mx-auto flex max-w-5xl items-center gap-1 px-4 py-1">
    <a
      href={home}
      class="mr-auto inline-flex min-h-tap items-center gap-2 font-bold no-underline"
      aria-label={t(lang, 'site.header.home')}
    >
      <img src="/icon.svg" width="32" height="32" alt="" />
      <span class="text-xl" lang="en"
        ><span class="text-saffron-text">Sahi</span><span class="text-primary">Size</span></span
      >
    </a>
    <nav aria-label={t(lang, 'site.header.nav')} class="hidden md:block">
      <ul class="flex items-center gap-1">
        <li>
          <a class="inline-flex min-h-tap items-center px-3 text-text no-underline hover:text-primary" href={examsHref}
            >{t(lang, 'site.header.exams')}</a
          >
        </li>
        <li>
          <a class="inline-flex min-h-tap items-center px-3 text-text no-underline hover:text-primary" href={localizePath('/guides', lang)}
            >{t(lang, 'site.header.guides')}</a
          >
        </li>
      </ul>
    </nav>
    {
      !hideSearch && (
        <div class="order-none">
          <ExamSearch
            client:idle
            variant="header"
            index={index}
            lang={lang}
            dict={dict}
            hiSlugs={hiSlugs}
            examsHref={examsHref}
          />
        </div>
      )
    }
    <LangToggle lang={lang} alternates={alternates} />
    <ThemeToggle lang={lang} />
  </div>
</header>
