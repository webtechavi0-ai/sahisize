---
/**
 * Per-exam written copy (SPEC 9.4) authored by Workstream D (en) and G (hi) in
 * src/content/exam-copy/{lang}/{slug}.md. Renders nothing if the file is missing.
 */
import type { Lang } from '@/config/site';
interface Props {
  lang: Lang;
  slug: string;
  title: string;
}
const { lang, slug, title } = Astro.props;
const mods = import.meta.glob<{ Content: (props: Record<string, unknown>) => unknown }>(
  '/src/content/exam-copy/*/*.md',
  { eager: true },
);
const mod = mods[`/src/content/exam-copy/${lang}/${slug}.md`];
const Content = mod?.Content;
---

{
  Content && (
    <section aria-labelledby="copy-h" class="mt-10">
      <h2 id="copy-h" class="text-xl font-bold">{title}</h2>
      <div class="prose mt-3 max-w-none dark:prose-invert prose-a:text-primary">
        <Content />
      </div>
    </section>
  )
}
