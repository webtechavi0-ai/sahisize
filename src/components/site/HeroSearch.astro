---
/**
 * Big exam search box (SPEC 6.2 #1, K1): B's ExamSearch island, hero variant.
 * Without JS the form submits to /exams?q=, which filters the list.
 */
import ExamSearch from '@/islands/ExamSearch';
import { getNamespace, localizePath } from '@/i18n';
import { getSearchIndex } from '@/content/presets';
import { getOtherDocsSearchIndex } from '@/config/other-docs';
import { hindiExamSlugs } from '@/seo/hreflang';
import type { Lang } from '@/config/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<ExamSearch
  client:idle
  variant="hero"
  index={getSearchIndex()}
  lang={lang}
  dict={getNamespace(lang, 'common', 'ui')}
  hiSlugs={hindiExamSlugs()}
  examsHref={localizePath('/exams', lang)}
  docs={getOtherDocsSearchIndex()}
/>
