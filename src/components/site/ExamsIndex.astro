---
/** /exams and /hi/exams (SPEC 4): all published exams grouped by body group, with search and filter. */
import Base from '@/layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ExamCard from './ExamCard.astro';
import { t, localizePath } from '@/i18n';
import type { Lang } from '@/config/site';
import { getPublishedPresets } from '@/content/presets';
import { staticAlternates } from '@/seo/hreflang';
import { localHref } from '@/seo/localize-href';
import { breadcrumbList } from '@/seo/jsonld';
import { GROUP_ORDER, groupKey } from './util';
import { familyMembers, hubFamilies, hubPath } from '@/seo/families';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const all = getPublishedPresets();
const groups = GROUP_ORDER.map((g) => ({
  g,
  exams: all.filter((p) => p.group === g).sort((a, b) => a.name.en.localeCompare(b.name.en)),
})).filter((x) => x.exams.length > 0);
const hubs = hubFamilies().map((f) => ({ f, count: familyMembers(f).length }));
const examHref = (s: string) => localHref(`/exam/${s}`, lang);
const customHref = localHref('/tools/custom-preset', lang);
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: localizePath('/', lang) },
  { name: tr('site.breadcrumb.exams'), path: localizePath('/exams', lang) },
];
---

<Base
  title={tr('site.exams.title')}
  description={tr('site.exams.description', { count: all.length })}
  lang={lang}
  canonicalPath={localizePath('/exams', lang)}
  alternates={staticAlternates('/exams')}
  ogImage="/og/exams.png"
  jsonLd={[breadcrumbList(crumbs)]}
>
  <Breadcrumbs lang={lang} crumbs={crumbs} />
  <h1 class="text-3xl font-bold">{tr('site.exams.h1')}</h1>
  <p class="mt-2 text-muted">{tr('site.exams.intro', { count: all.length })}</p>

  <nav aria-labelledby="fam-h" class="mt-5">
    <h2 id="fam-h" class="text-lg font-bold">{tr('site.hub.familiesTitle')}</h2>
    <ul class="mt-2 flex flex-wrap gap-2">
      {
        hubs.map(({ f, count }) => (
          <li>
            <a
              href={hubPath(f)}
              class="inline-flex min-h-tap items-center rounded-card border border-border-strong bg-surface px-4 font-semibold no-underline hover:border-primary"
            >
              {tr('site.hub.familyCard', { family: f.name, count })}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-6 space-y-3" data-exam-filter>
    <form role="search" action={localizePath('/exams', lang)} method="get" class="flex gap-2">
      <label for="exams-q" class="sr-only">{tr('site.exams.searchLabel')}</label>
      <input
        id="exams-q"
        name="q"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder={tr('site.header.searchPlaceholder')}
        class="h-tap min-w-0 flex-1 rounded-card border border-border-strong bg-surface px-3 text-text placeholder:text-muted"
      />
      <button type="submit" class="btn-action">{tr('site.header.searchSubmit')}</button>
    </form>
    <div
      role="group"
      aria-label={tr('site.exams.filterLabel')}
      class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-2 [scrollbar-width:thin] sm:flex-wrap sm:overflow-visible"
    >
      <button type="button" data-group-chip="" aria-pressed="true" class="chip"
        >{tr('site.exams.all')} <span class="chip-n">{all.length}</span></button
      >
      {
        groups.map(({ g, exams }) => (
          <button type="button" data-group-chip={g} aria-pressed="false" class="chip">
            {tr(groupKey(g))} <span class="chip-n">{exams.length}</span>
          </button>
        ))
      }
    </div>
    <p data-exam-count class="sr-only" aria-live="polite"></p>
  </div>


  <p data-no-results hidden class="card mt-6 p-4">{tr('site.exams.noResults')}</p>

  {
    groups.map(({ g, exams }) => (
      <section aria-labelledby={`g-${g}`} class="mt-8" data-group-section={g}>
        <h2 id={`g-${g}`} class="text-xl font-bold">
          {tr(groupKey(g))}
        </h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {exams.map((p) => (
            <ExamCard lang={lang} preset={p} href={examHref(p.slug)} filterable />
          ))}
        </ul>
      </section>
    ))
  }

  <aside class="card mt-10 p-4 sm:p-5" aria-labelledby="cant-find-h" data-cant-find>
    <h2 id="cant-find-h" class="text-lg font-bold text-ink">{tr('ui.search.cantFind')}</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      <li>
        <a href={customHref} class="flex min-h-[56px] flex-col justify-center rounded-xl border border-rule-strong bg-card px-4 py-2 no-underline hover:border-ink">
          <span class="font-semibold text-ink">{tr('ui.search.useCustom')}</span>
          <span class="text-sm text-muted">{tr('ui.search.useCustomDesc')}</span>
        </a>
      </li>
      <li>
        <a href="/report" hreflang={lang === 'hi' ? 'en-IN' : undefined} class="flex min-h-[56px] flex-col justify-center rounded-xl border border-rule-strong bg-card px-4 py-2 no-underline hover:border-ink">
          <span class="font-semibold text-ink">{tr('ui.search.tellUs')}</span>
          <span class="text-sm text-muted">{tr('ui.search.tellUsDesc')}</span>
        </a>
      </li>
    </ul>
  </aside>
</Base>
<style is:global>
  .chip {
    @apply inline-flex min-h-tap items-center rounded-full border border-border-strong bg-surface px-4 text-sm font-semibold text-text;
  }
  .chip {
    @apply shrink-0 gap-1.5 whitespace-nowrap;
  }
  .chip-n {
    @apply rounded-full bg-paper px-1.5 text-xs text-muted;
  }
  .chip[aria-pressed='true'] {
    @apply border-primary bg-primary text-on-primary;
  }
  .chip[aria-pressed='true'] .chip-n {
    @apply bg-on-primary/20 text-on-primary;
  }
</style>
<script>
  import { initExamFilter } from '@/scripts/exams-filter';
  initExamFilter();
</script>
