---
/**
 * Spec table (SPEC 6.3 #3): document, size in px/cm, KB range, format, DPI, rules.
 * Documents with maxKB null (Q15) show "Size to verify". Scrolls horizontally on
 * narrow screens; each row also links to its document page.
 */
import { t } from '@/i18n';
import type { Lang } from '@/config/site';
import type { ExamPreset } from '@/content/presets/schema';
import { docSlug, isFittable } from '@/content/presets';
import { kbText, physicalText, pxText } from '@/seo/spec-text';
interface Props {
  lang: Lang;
  preset: ExamPreset;
  /** Base path for document links, e.g. "/exam/ibps-po". Omit to not link. */
  docBase?: string;
  /** Only these documents (by docSlug). */
  only?: string[];
}
const { lang, preset: p, docBase, only } = Astro.props;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const docs = p.documents.filter((d) => !only || only.includes(docSlug(d)));
const anyKB = (d: (typeof docs)[number]) =>
  pxText(d, lang) === null && physicalText(d) === null;
---

<div class="overflow-x-auto rounded-card border border-border bg-surface">
  <table class="w-full min-w-[640px] border-collapse text-left text-sm">
    <caption class="sr-only">{tr('site.exam.specCaption', { exam: p.name[lang], cycle: p.cycle })}</caption>
    <thead class="bg-bg text-muted">
      <tr>
        <th scope="col" class="px-3 py-2 font-semibold">{tr('site.exam.colDocument')}</th>
        <th scope="col" class="px-3 py-2 font-semibold">{tr('site.exam.colSize')}</th>
        <th scope="col" class="px-3 py-2 font-semibold">{tr('site.exam.colKb')}</th>
        <th scope="col" class="px-3 py-2 font-semibold">{tr('site.exam.colFormat')}</th>
        <th scope="col" class="px-3 py-2 font-semibold">{tr('site.exam.colDpi')}</th>
        <th scope="col" class="px-3 py-2 font-semibold">{tr('site.exam.colRules')}</th>
      </tr>
    </thead>
    <tbody>
      {
        docs.map((d) => {
          const fittable = isFittable(d);
          const px = pxText(d, lang);
          const phys = physicalText(d);
          const kb = kbText(d, lang);
          const href = docBase && fittable ? `${docBase}/${docSlug(d)}` : null;
          return (
            <tr class="border-t border-border align-top">
              <th scope="row" class="px-3 py-3 font-semibold text-text">
                {href ? <a href={href}>{d.label[lang]}</a> : d.label[lang]}
                {d.optional && (
                  <span class="mt-1 block text-xs font-normal text-muted">
                    {tr('site.exam.optional')}
                    {d.appliesTo ? `: ${d.appliesTo[lang]}` : ''}
                  </span>
                )}
                {d.disputed && (
                  <span class="mt-1 block text-xs font-normal text-error-text">{tr('site.exam.disputed')}</span>
                )}
              </th>
              <td class="whitespace-nowrap px-3 py-3">
                {px && <span class="block">{px}</span>}
                {phys && (
                  <span class="block text-muted">
                    {phys}
                    {d.pxDerived ? ` (${tr('site.exam.derived')})` : ''}
                  </span>
                )}
                {!px && !phys && d.format !== 'pdf' && (anyKB(d) ? <span class="text-muted">{tr('site.exam.any')}</span> : null)}
                {!px && !phys && d.format === 'pdf' && <span class="text-muted">—</span>}
              </td>
              <td class="whitespace-nowrap px-3 py-3 font-semibold">
                {fittable ? kb : <span class="text-error-text">{tr('site.exam.toVerify')}</span>}
              </td>
              <td class="px-3 py-3">{d.format.toUpperCase()}</td>
              <td class="px-3 py-3">{d.dpi ?? '—'}</td>
              <td class="px-3 py-3">
                <ul class="list-disc space-y-0.5 pl-4">
                  {d.rules.map((r) => <li>{r[lang]}</li>)}
                  {d.variant === 'dual-language' && <li>{tr('site.exam.variantDual')}</li>}
                  {d.variant === 'triple' && <li>{tr('site.exam.variantTriple')}</li>}
                  {d.needsNameDateStrip && <li>{tr('site.exam.nameDateStrip')}</li>}
                </ul>
                {d.sizeNote && (
                  <p class="mt-1 text-xs text-muted">
                    {tr('site.exam.noteLabel')}: {d.sizeNote[lang]}
                  </p>
                )}
                {!fittable && <p class="mt-1 text-xs text-muted">{tr('site.exam.toVerifyNote')}</p>}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
