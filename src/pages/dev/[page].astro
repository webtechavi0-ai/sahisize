---
/**
 * Dev-only engine smoke page: /dev/engine-smoke (PLAN 4 Phase 2 A9, Q18).
 * A dynamic route whose getStaticPaths is empty in production, so `astro build` emits nothing
 * (no sitemap entry, no precache, not linked). In `astro dev` it renders and Playwright can
 * wait for `body[data-status="pass"]`.
 */
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'engine-smoke' } }] : [];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Engine smoke (dev)</title>
  </head>
  <body data-status="idle">
    <h1>SahiSize engine smoke test (dev only)</h1>
    <p>
      <label>Optional image: <input type="file" id="file" accept="image/*" /></label>
      <button id="run" type="button">Run</button>
    </p>
    <pre id="log" aria-live="polite"></pre>
    <script>
      import * as engine from '@/engine/api';
      import type { DocSpec } from '@/engine/types';

      const log = document.getElementById('log')!;
      const out = (s: string) => (log.textContent += s + '\n');

      const ibpsPhoto: DocSpec = {
        doc: 'photo',
        label: { en: 'Photograph', hi: 'फोटो' },
        widthPx: 200,
        heightPx: 230,
        minKB: 20,
        maxKB: 50,
        format: 'jpg',
        dpi: 200,
        fileName: 'photo.jpg',
        rules: [],
      };

      async function syntheticJpeg(): Promise<Blob> {
        const c = document.createElement('canvas');
        c.width = 1200;
        c.height = 1500;
        const g = c.getContext('2d')!;
        g.fillStyle = '#f4f4f4';
        g.fillRect(0, 0, 1200, 1500);
        g.fillStyle = '#d9a37f';
        g.beginPath();
        g.ellipse(600, 650, 260, 340, 0, 0, Math.PI * 2);
        g.fill();
        g.fillStyle = '#234';
        g.fillRect(150, 1150, 900, 350);
        return new Promise((res) => c.toBlob((b) => res(b!), 'image/jpeg', 0.92));
      }

      async function run() {
        document.body.dataset.status = 'running';
        log.textContent = '';
        try {
          engine.prewarm();
          const input = (document.getElementById('file') as HTMLInputElement).files?.[0] ?? (await syntheticJpeg());
          const img = await engine.decode(input);
          out(`decode: ${img.width}×${img.height}`);
          const fit = await engine.fit(img, ibpsPhoto);
          out(`fit: ${fit.widthPx}×${fit.heightPx} ${(fit.sizeBytes / 1024).toFixed(1)} KB q${fit.quality} stages=${fit.stages.join(',')} ${fit.durationMs} ms`);
          for (const c of fit.checks) out(`  ${c.pass ? 'PASS' : 'FAIL'} ${c.rule}: ${c.actual} (need ${c.required})`);
          const ok = fit.checks.every((c) => c.pass || (c.level ?? 'required') !== 'required');
          const pv = await engine.preview(img, { maxSide: 256 });
          out(`preview: ${pv.width}×${pv.height} ${pv.bytes.length} B`);
          const pdf = await engine.imagesToPdf([img], { page: 'a4', maxKB: 300 });
          out(`imagesToPdf: ${(pdf.length / 1024).toFixed(1)} KB`);
          const pages = await engine.decodePdfPages(new Blob([pdf], { type: 'application/pdf' }), { dpi: 72 });
          out(`decodePdfPages: ${pages.length} page(s) ${pages[0]?.width}×${pages[0]?.height}`);
          pages.forEach((p) => engine.release(p));
          const z = await engine.zip([{ name: 'photo.jpg', bytes: fit.bytes }], 'Exam: smoke');
          out(`zip: ${z.length} B`);
          engine.release(img);
          document.body.dataset.status = ok && pages.length === 1 ? 'pass' : 'fail';
          out(document.body.dataset.status.toUpperCase());
        } catch (e) {
          out(`ERROR ${(e as { code?: string }).code ?? ''} ${String(e)}`);
          document.body.dataset.status = 'fail';
        }
      }
      document.getElementById('run')!.addEventListener('click', run);
      if (new URLSearchParams(location.search).has('auto')) void run();
    </script>
  </body>
</html>
