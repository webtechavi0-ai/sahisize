---
/** /exam/[slug] (SPEC 4, 6.3). Published presets only. */
import Exam from '@/layouts/Exam.astro';
import { getPublishedPresets, type ExamPreset } from '@/content/presets';

export function getStaticPaths() {
  return getPublishedPresets().map((preset) => ({ params: { slug: preset.slug }, props: { preset } }));
}
interface Props {
  preset: ExamPreset;
}
const { preset } = Astro.props;
---

<Exam lang="en" preset={preset} />
