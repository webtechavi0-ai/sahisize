---
/**
 * /report (SPEC 4, K15): builds a mailto: link from the form, prefilled from
 * ?exam=&doc= (FeedbackPrompt sends users here). No attachments, nothing is sent
 * by the page itself. noindex.
 */
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n';
import { CONTACT_EMAIL, SITE_NAME } from '@/config/site';
import { getPublishedPresets, docSlug } from '@/content/presets';
const lang = 'en' as const;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const exams = getPublishedPresets()
  .slice()
  .sort((a, b) => a.name.en.localeCompare(b.name.en));
const docTypes = ['photo', 'signature', 'thumb', 'declaration', 'certificate', 'other'] as const;
// Per-exam document keys (for exams with e.g. signature-hindi) are added as extra options.
const extraDocs = [...new Set(exams.flatMap((p) => p.documents.map((d) => docSlug(d))))].filter(
  (k) => !(docTypes as readonly string[]).includes(k),
);
const field = 'mt-1 block w-full rounded-card border border-border-strong bg-surface px-3 text-text';
---

<Base title={tr('site.report.title')} description={tr('site.report.description')} canonicalPath="/report" noindex>
  <h1 class="text-3xl font-bold">{tr('site.report.h1')}</h1>
  <p class="mt-2 max-w-2xl text-muted">{tr('site.report.intro')}</p>
  <form id="report-form" class="mt-6 max-w-xl space-y-5" data-email={CONTACT_EMAIL} data-site={SITE_NAME} novalidate>
    <div>
      <label for="r-exam" class="font-semibold">{tr('site.report.exam')}</label>
      <select id="r-exam" name="exam" class={`${field} h-tap`}>
        <option value="">{tr('site.report.examNone')}</option>
        {exams.map((p) => <option value={p.slug}>{p.name.en} {p.cycle}</option>)}
      </select>
    </div>
    <div>
      <label for="r-doc" class="font-semibold">{tr('site.report.doc')}</label>
      <select id="r-doc" name="doc" class={`${field} h-tap`}>
        <option value="">{tr('site.report.docNone')}</option>
        {docTypes.map((d) => <option value={d}>{t(lang, `common.docTypes.${d}`)}</option>)}
        {extraDocs.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
    <fieldset>
      <legend class="font-semibold">{tr('site.report.what')}</legend>
      <div class="mt-1 space-y-1">
        {
          (['rejected', 'wrong', 'other'] as const).map((v, i) => (
            <label class="flex min-h-tap items-center gap-3">
              <input type="radio" name="what" value={v} checked={i === 0} class="h-5 w-5" />
              {tr(`site.report.what${v[0]!.toUpperCase()}${v.slice(1)}`)}
            </label>
          ))
        }
      </div>
    </fieldset>
    <div>
      <label for="r-error" class="font-semibold">{tr('site.report.errorMsg')}</label>
      <input id="r-error" name="error" type="text" maxlength="300" class={`${field} h-tap`} />
    </div>
    <div>
      <label for="r-details" class="font-semibold">{tr('site.report.details')}</label>
      <textarea id="r-details" name="details" rows="4" maxlength="1500" class={`${field} py-2`}></textarea>
    </div>
    <p class="text-sm text-muted">{tr('site.report.privacy')}</p>
    <button type="submit" class="btn-action w-full sm:w-auto">{tr('site.report.submit')}</button>
    <p class="text-sm text-muted">
      {tr('site.report.fallback', { email: CONTACT_EMAIL })}
    </p>
  </form>
</Base>
<script>
  import { buildReportMailto } from '@/scripts/report';
  const form = document.getElementById('report-form') as HTMLFormElement | null;
  if (form) {
    const params = new URLSearchParams(location.search);
    const exam = form.elements.namedItem('exam') as HTMLSelectElement;
    const doc = form.elements.namedItem('doc') as HTMLSelectElement;
    const pick = (sel: HTMLSelectElement, v: string | null) => {
      if (v && [...sel.options].some((o) => o.value === v)) sel.value = v;
    };
    pick(exam, params.get('exam'));
    pick(doc, params.get('doc'));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const what = form.querySelector<HTMLInputElement>('input[name="what"]:checked');
      const whatLabel = what?.parentElement?.textContent?.trim() ?? '';
      const href = buildReportMailto({
        to: form.dataset.email!,
        site: form.dataset.site!,
        exam: String(fd.get('exam') ?? ''),
        examLabel: exam.selectedOptions[0]?.textContent?.trim() ?? '',
        doc: String(fd.get('doc') ?? ''),
        what: whatLabel,
        error: String(fd.get('error') ?? ''),
        details: String(fd.get('details') ?? ''),
        page: location.origin,
      });
      location.href = href;
    });
  }
</script>
