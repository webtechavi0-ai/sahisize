---
/** /sources (SPEC 5.3): every published preset with its official source, page and last-checked date. */
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import { t } from '@/i18n';
import { getSources } from '@/content/presets';
import { breadcrumbList } from '@/seo/jsonld';
import { formatDate } from '@/seo/spec-text';
const lang = 'en' as const;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const rows = getSources();
const conf: Record<string, string> = {
  H: tr('site.sources.confidenceH'),
  M: tr('site.sources.confidenceM'),
  'H/M': tr('site.sources.confidenceHM'),
  'M/L': tr('site.sources.confidenceML'),
  L: tr('site.sources.confidenceML'),
};
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: '/' },
  { name: tr('site.sources.h1'), path: '/sources' },
];
---

<Base
  title={tr('site.sources.title')}
  description={tr('site.sources.description')}
  canonicalPath="/sources"
  alternates={{ en: '/sources', hi: null }}
  jsonLd={[breadcrumbList(crumbs)]}
>
  <Breadcrumbs lang={lang} crumbs={crumbs} />
  <h1 class="text-3xl font-bold">{tr('site.sources.h1')}</h1>
  <p class="mt-2 max-w-3xl text-muted">
    {tr('site.sources.intro')} <a href="/report" class="underline">{tr('site.footer.report')}</a>
  </p>
  <div class="mt-6 overflow-x-auto rounded-card border border-border bg-surface">
    <table class="w-full min-w-[720px] text-left text-sm">
      <thead class="bg-bg text-muted">
        <tr>
          <th scope="col" class="px-3 py-2">{tr('site.sources.colExam')}</th>
          <th scope="col" class="px-3 py-2">{tr('site.sources.colNotification')}</th>
          <th scope="col" class="px-3 py-2">{tr('site.sources.colSource')}</th>
          <th scope="col" class="px-3 py-2">{tr('site.sources.colChecked')}</th>
          <th scope="col" class="px-3 py-2">{tr('site.sources.colConfidence')}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr class="border-t border-border align-top">
              <th scope="row" class="px-3 py-3 font-semibold">
                <a href={`/exam/${r.slug}`} class="inline-flex min-h-[48px] items-center">{r.name.en}</a>
                <span class="block text-xs font-normal text-muted">{r.body} · {r.cycle}</span>
              </th>
              <td class="px-3 py-3">{r.notification}</td>
              <td class="px-3 py-3">
                <a href={r.sourceUrl} rel="noopener nofollow external" target="_blank" class="inline-flex min-h-[48px] items-center break-all">
                  {new URL(r.sourceUrl).hostname}
                </a>
                {r.sourcePage && <span class="text-muted"> · {tr('site.exam.sourcePage', { page: r.sourcePage })}</span>}
                {r.extraSources.map((s) => (
                  <a href={s.url} rel="noopener nofollow external" target="_blank" class="flex min-h-[48px] items-center">
                    {s.label}
                  </a>
                ))}
              </td>
              <td class="whitespace-nowrap px-3 py-3">
                <time datetime={r.lastChecked}>{formatDate(r.lastChecked)}</time>
              </td>
              <td class="px-3 py-3">{conf[r.confidence]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>
