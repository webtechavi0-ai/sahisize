---
/** Service-worker navigate fallback (PLAN 3.15). Precached; noindex. */
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n';
import { getSeasonOrder } from '@/content/presets';
import { TOOLS } from '@/config/tools';
import { toolNameKey } from '@/components/site/util';
const lang = 'en' as const;
const tr = (k: string) => t(lang, k);
const kits = getSeasonOrder().slice(0, 8);
---

<Base title={tr('site.offline.title')} description={tr('site.offline.text')} canonicalPath="/offline" noindex>
  <h1 class="text-3xl font-bold">{tr('site.offline.h1')}</h1>
  <p class="mt-2 text-muted">{tr('site.offline.text')}</p>
  <p class="mt-4"><a href="" class="btn-action" data-reload>{tr('site.offline.retry')}</a></p>
  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <section>
      <h2 class="text-lg font-bold">{tr('site.header.tools')}</h2>
      <ul class="mt-2 space-y-1">
        {TOOLS.map((x) => <li><a class="inline-flex min-h-[48px] items-center" href={x.path}>{tr(toolNameKey(x.slug))}</a></li>)}
      </ul>
    </section>
    <section>
      <h2 class="text-lg font-bold">{tr('site.header.exams')}</h2>
      <ul class="mt-2 space-y-1">
        {kits.map((p) => <li><a class="inline-flex min-h-[48px] items-center" href={`/kit/${p.slug}`}>{p.name.en}</a></li>)}
      </ul>
    </section>
  </div>
</Base>
<script>
  document.querySelector('[data-reload]')?.addEventListener('click', (e) => {
    e.preventDefault();
    location.reload();
  });
</script>
