---
/** /kit/[slug] (SPEC 4, 6.4). Published presets with at least one fittable document. */
import Kit from '@/layouts/Kit.astro';
import { getKitDocuments, getPublishedPresets, type ExamPreset } from '@/content/presets';

export function getStaticPaths() {
  return getPublishedPresets()
    .filter((p) => getKitDocuments(p).length > 0)
    .map((preset) => ({ params: { slug: preset.slug }, props: { preset } }));
}
interface Props {
  preset: ExamPreset;
}
const { preset } = Astro.props;
---

<Kit lang="en" preset={preset} />
