---
/**
 * /exams/<family> exam-family hubs (docs/seo/keyword-map.md "Exams"): a comparison table
 * of every published exam in the family (from presets, with source and checked date),
 * written copy on what differs and the live photo, links down to each exam and document
 * page and to the tools, and an FAQ. Breadcrumb, FAQPage and ItemList JSON-LD.
 */
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import FaqList from '@/components/site/FaqList.astro';
import Icon from '@/components/site/Icon.astro';
import { t } from '@/i18n';
import { docSlug, getKitDocuments } from '@/content/presets';
import { familyMembers, hubFamilies, hubPath, type ExamFamily } from '@/seo/families';
import { hubCopy } from '@/seo/hub-copy';
import { fitTitle, clampDescription } from '@/seo/meta';
import { breadcrumbList, faqPage, itemList } from '@/seo/jsonld';
import { formatDate, verifiedSummary } from '@/seo/spec-text';
import { toolNameKey } from '@/components/site/util';

export function getStaticPaths() {
  return hubFamilies().map((family) => ({ params: { family: family.slug }, props: { family } }));
}
interface Props {
  family: ExamFamily;
}
const { family: f } = Astro.props;
const lang = 'en' as const;
const tr = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const copy = hubCopy(f.slug);
const { Content } = copy;
const members = familyMembers(f);
const path = hubPath(f);
const crumbs = [
  { name: tr('site.breadcrumb.home'), path: '/' },
  { name: tr('site.breadcrumb.exams'), path: '/exams' },
  { name: tr('site.hub.crumb', { family: f.name }), path },
];
const anyLive = members.some((p) => p.photoUploadReplacedByLive);
const docsOf = (p: (typeof members)[number]) => p.documents.filter((d) => d.doc !== 'photo');
const photoOf = (p: (typeof members)[number]) => p.documents.find((d) => d.doc === 'photo');
const toolSlugs = [
  'signature-resize',
  'thumb-impression',
  'compress-image',
  ...(members.some((p) => p.documents.some((d) => d.doc === 'declaration'))
    ? ['handwritten-declaration']
    : []),
  ...(members.some((p) => p.documents.some((d) => d.format === 'pdf')) ? ['compress-pdf'] : []),
];
const jsonLd = [
  breadcrumbList(crumbs),
  itemList(
    copy.tableH2,
    members.map((p) => ({ name: p.name.en, path: `/exam/${p.slug}` })),
  ),
  faqPage(copy.faq),
];
---

<Base
  title={fitTitle([copy.title])}
  description={clampDescription(copy.description)}
  lang={lang}
  canonicalPath={path}
  alternates={{ en: path, hi: null }}
  ogImage="/og/exams.png"
  jsonLd={jsonLd}
>
  <Breadcrumbs lang={lang} crumbs={crumbs} />
  <h1 class="text-2xl font-bold leading-tight sm:text-3xl">{copy.h1}</h1>
  <p class="mt-3 max-w-3xl text-lg">{copy.intro}</p>
  {
    anyLive && (
      <p class="mt-4 flex max-w-3xl gap-2 rounded-card border border-border bg-surface p-3">
        <Icon name="info" size={20} class="mt-0.5 shrink-0 text-primary" />
        <span>{tr('site.hub.liveNote', { family: f.name })}</span>
      </p>
    )
  }

  <section class="mt-8" aria-labelledby="cmp-h">
    <h2 id="cmp-h" class="mb-3 text-xl font-bold">{copy.tableH2}</h2>
    <div
      class="overflow-x-auto rounded-card border border-border bg-surface"
      role="region"
      aria-labelledby="cmp-h"
      tabindex="0"
    >
      <table class="w-full min-w-[640px] border-collapse text-left text-sm" aria-labelledby="cmp-h">
        <thead class="bg-bg text-muted">
          <tr>
            <th scope="col" class="px-3 py-2 font-semibold">{tr('site.hub.colExam')}</th>
            <th scope="col" class="px-3 py-2 font-semibold">{tr('site.hub.colPhoto')}</th>
            <th scope="col" class="px-3 py-2 font-semibold">{tr('site.hub.colUploads')}</th>
            <th scope="col" class="px-3 py-2 font-semibold">{tr('site.hub.colSource')}</th>
          </tr>
        </thead>
        <tbody>
          {
            members.map((p) => {
              const photo = photoOf(p);
              return (
                <tr class="border-t border-border align-top">
                  <th scope="row" class="px-3 py-3 font-semibold text-text">
                    <a href={`/exam/${p.slug}`}>{p.name.en}</a>
                    <span class="block text-xs font-normal text-muted">{p.cycle}</span>
                  </th>
                  <td class="px-3 py-3">
                    {photo
                      ? verifiedSummary(photo)
                      : p.photoUploadReplacedByLive
                        ? tr('site.hub.livePhoto')
                        : '—'}
                  </td>
                  <td class="px-3 py-3">
                    <ul class="space-y-1">
                      {docsOf(p).map((d) => (
                        <li>
                          <span class="font-semibold">{d.label.en}:</span> {verifiedSummary(d)}
                          {d.optional && (
                            <span class="text-muted">
                              {' '}
                              ({tr('site.exam.optional').toLowerCase()})
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </td>
                  <td class="px-3 py-3">
                    {`${p.notification}${p.sourcePage ? `, ${tr('site.exam.sourcePage', { page: p.sourcePage })}` : ''}`}
                    <span class="block text-muted">
                      {tr('site.hub.checked', { date: formatDate(p.lastChecked) })} ·{' '}
                      <a href={p.sourceUrl} rel="noopener nofollow external" target="_blank">
                        {tr('site.exam.source')}
                      </a>
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="prose mt-8 max-w-none dark:prose-invert prose-a:text-primary">
    <Content />
  </div>

  <section class="mt-10" aria-labelledby="links-h">
    <h2 id="links-h" class="text-xl font-bold">{copy.linksH2}</h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        members.map((p) => (
          <li class="card p-4">
            <a href={`/exam/${p.slug}`} class="font-semibold">
              {tr('site.hub.examLink', { exam: p.name.en })}
            </a>
            <ul class="mt-1 flex flex-wrap gap-x-3 text-sm">
              {getKitDocuments(p).map((d) => (
                <li>
                  <a
                    href={`/exam/${p.slug}/${docSlug(d)}`}
                    class="inline-flex min-h-tap items-center"
                  >
                    {d.label.en}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-6 font-bold">{tr('site.hub.toolsTitle', { family: f.name })}</h3>
    <ul class="mt-2 flex flex-wrap gap-2">
      {
        toolSlugs.map((s) => (
          <li>
            <a
              href={`/tools/${s}`}
              class="inline-flex min-h-tap items-center rounded-card border border-border bg-surface px-4 no-underline hover:border-primary"
            >
              {tr(toolNameKey(s))}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <FaqList title={copy.faqH2} items={copy.faq} />

  <p class="mt-8">
    <a href="/exams" class="inline-flex min-h-tap items-center font-semibold"
      >{tr('site.hub.allExams')}</a
    >
  </p>
</Base>
