---
/** Guide article from the content collection (src/content/guides/en/*.mdx). */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Guide from '@/layouts/Guide.astro';

export async function getStaticPaths() {
  const all = await getCollection('guides', (g) => !g.data.draft);
  const other = new Set(all.filter((g) => g.data.lang === 'hi').map((g) => g.data.slug));
  return all
    .filter((g) => g.data.lang === 'en')
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry, hasCounterpart: other.has(entry.data.slug) },
    }));
}
interface Props {
  entry: CollectionEntry<'guides'>;
  hasCounterpart: boolean;
}
const { entry, hasCounterpart } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Guide
  lang="en"
  title={d.title}
  description={d.description}
  slug={d.slug}
  publishedAt={d.publishedAt}
  updatedAt={d.updatedAt}
  relatedExams={d.relatedExams}
  relatedTools={d.relatedTools}
  hasCounterpart={hasCounterpart}
>
  <Content />
</Guide>
