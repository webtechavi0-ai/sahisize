---
/** T9 /tools/batch-compress (SPEC 5.2, P1). */
import Tool from '@/layouts/Tool.astro';
import ToolBatch from '@/islands/tools/ToolBatch';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { batchCopy } from '@/components/tools/copy/more';
const lang = 'en';
const c = batchCopy();
---

<Tool lang={lang} tool="batch-compress" path="/tools/batch-compress" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolBatch client:visible lang={lang} dict={toolDict(lang)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
