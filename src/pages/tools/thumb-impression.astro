---
/** T5 /tools/thumb-impression (SPEC 5.2). */
import Tool from '@/layouts/Tool.astro';
import ToolThumb from '@/islands/tools/ToolThumb';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { sizeOptions } from '@/components/tools/presets-server';
import { thumbCopy } from '@/components/tools/copy/ink';
const lang = 'en';
const c = thumbCopy();
const options = sizeOptions('thumb', lang);
---

<Tool lang={lang} tool="thumb-impression" path="/tools/thumb-impression" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolThumb client:visible lang={lang} dict={toolDict(lang)} options={options} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
