---
/** /tools/handwritten-declaration: K13 standalone (text generator, trace sheet PDF, scan resize). */
import Tool from '@/layouts/Tool.astro';
import ToolDeclaration from '@/islands/tools/ToolDeclaration';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { declarationExams, sizeOptions } from '@/components/tools/presets-server';
import { declarationCopy } from '@/components/tools/copy/ink';
const lang = 'en';
const c = declarationCopy();
const exams = declarationExams(lang).map(({ slug, name, text, toVerify }) => ({ slug, name, text, toVerify }));
const options = sizeOptions('declaration', lang);
---

<Tool lang={lang} tool="handwritten-declaration" path="/tools/handwritten-declaration" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolDeclaration client:visible lang={lang} dict={toolDict(lang)} exams={exams} options={options} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
