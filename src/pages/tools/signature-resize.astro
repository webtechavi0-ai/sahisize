---
/** T4 /tools/signature-resize (SPEC 5.2). */
import Tool from '@/layouts/Tool.astro';
import ToolSignature from '@/islands/tools/ToolSignature';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { sizeOptions } from '@/components/tools/presets-server';
import { signatureCopy } from '@/components/tools/copy/ink';
const lang = 'en';
const c = signatureCopy(lang);
const options = sizeOptions('signature', lang);
---

<Tool lang={lang} tool="signature-resize" path="/tools/signature-resize" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolSignature client:visible lang={lang} dict={toolDict(lang)} options={options} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
