---
/** T7 /tools/compress-pdf (SPEC 5.2, P1). */
import Tool from '@/layouts/Tool.astro';
import ToolCompressPdf from '@/islands/tools/ToolCompressPdf';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { compressPdfCopy } from '@/components/tools/copy/pdf';
const lang = 'en';
const c = compressPdfCopy();
---

<Tool lang={lang} tool="compress-pdf" path="/tools/compress-pdf" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolCompressPdf client:visible lang={lang} dict={toolDict(lang)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
