---
/**
 * Route shell (Workstream C, Phase 2). Workstream F replaces the placeholder with
 * the tool island and the final copy in Phase 3.
 */
import Tool from '@/layouts/Tool.astro';
---

<Tool
  tool="compress-pdf"
  path="/tools/compress-pdf"
  title={"Compress PDF to Under Any KB — Free, No Upload"}
  description={"Reduce a scanned PDF to under 100, 200 or 300 KB for exam forms. Processed on your device, never uploaded."}
  h1={"Compress PDF under a KB limit"}
  intro={"Pick the maximum size. We re-render the pages until the PDF fits."}
  steps={[{"name": "Add your file", "text": "Take a photo or choose one from your gallery. It stays on your device."}, {"name": "Adjust", "text": "Crop and set the size you need."}, {"name": "Download", "text": "Check the ticks, then download."}]}
/>
