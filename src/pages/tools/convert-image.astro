---
/** T3 /tools/convert-image (SPEC 5.2). */
import Tool from '@/layouts/Tool.astro';
import ToolConvert from '@/islands/tools/ToolConvert';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { convertCopy } from '@/components/tools/copy/resize-convert';
const lang = 'en';
const c = convertCopy();
---

<Tool lang={lang} tool="convert-image" path="/tools/convert-image" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolConvert client:visible lang={lang} dict={toolDict(lang)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
