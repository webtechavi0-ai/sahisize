---
/** T1 framed as "photo MB to KB" (/tools/mb-to-kb-photo), 100 KB preselected. */
import Tool from '@/layouts/Tool.astro';
import ToolCompress from '@/islands/tools/ToolCompress';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { mbToKbCopy } from '@/components/tools/copy/kb-ranges';
import { MB_TO_KB_PATH } from '@/config/tools';
const lang = 'en';
const c = mbToKbCopy();
---

<Tool lang={lang} tool="compress-image" path={MB_TO_KB_PATH} title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolCompress client:visible lang={lang} dict={toolDict(lang)} initialKB={100} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
