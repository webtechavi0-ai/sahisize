---
/** T1 /tools/compress-image-to-[n]kb, n in COMPRESS_KB_TARGETS (SPEC 4). Unique copy per n. */
import Tool from '@/layouts/Tool.astro';
import ToolCompress from '@/islands/tools/ToolCompress';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { compressKbCopy } from '@/components/tools/copy/compress';
import { COMPRESS_KB_TARGETS } from '@/config/tools';

export function getStaticPaths() {
  return COMPRESS_KB_TARGETS.map((n) => ({ params: { n: String(n) }, props: { n } }));
}
interface Props {
  n: number;
}
const { n } = Astro.props;
const lang = 'en';
const c = compressKbCopy(n, lang);
---

<Tool lang={lang} tool="compress-image" path={`/tools/compress-image-to-${n}kb`} title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolCompress client:visible lang={lang} dict={toolDict(lang)} initialKB={n} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
