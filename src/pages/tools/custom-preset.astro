---
/** T10 /tools/custom-preset (SPEC 5.2): noindex (SPEC 9.1), settings in the query string. */
import Tool from '@/layouts/Tool.astro';
import ToolCustomPreset from '@/islands/tools/ToolCustomPreset';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { customPresetCopy } from '@/components/tools/copy/more';
const lang = 'en';
const c = customPresetCopy();
---

<Tool lang={lang} tool="custom-preset" path="/tools/custom-preset" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq} noindex>
  <ToolCustomPreset client:visible lang={lang} dict={toolDict(lang)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
