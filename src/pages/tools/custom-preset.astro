---
/**
 * Route shell (Workstream C, Phase 2). Workstream F replaces the placeholder with
 * the tool island and the final copy in Phase 3.
 */
import Tool from '@/layouts/Tool.astro';
---

<Tool
  tool="custom-preset"
  path="/tools/custom-preset"
  title={"Custom Size Preset: Any Pixels, KB Range and DPI — Free"}
  description={"Set any width, height, minimum and maximum KB, DPI and format, and share the settings as a link."}
  h1={"Custom size (any px, KB, DPI)"}
  intro={"Type the exact rules from your form. Share the link with friends applying to the same form."}
  steps={[{"name": "Add your file", "text": "Take a photo or choose one from your gallery. It stays on your device."}, {"name": "Adjust", "text": "Crop and set the size you need."}, {"name": "Download", "text": "Check the ticks, then download."}]}
  noindex
/>
