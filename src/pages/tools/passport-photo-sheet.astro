---
/**
 * Route shell (Workstream C, Phase 2). Workstream F replaces the placeholder with
 * the tool island and the final copy in Phase 3.
 */
import Tool from '@/layouts/Tool.astro';
---

<Tool
  tool="passport-photo-sheet"
  path="/tools/passport-photo-sheet"
  title={"Passport Photo Sheet: 4, 8, 12 or 16 Photos on A4 or 4×6 — Free"}
  description={"Make a printable sheet of passport photos (3.5×4.5 cm) on A4 or 4×6 inch paper at 300 DPI with cut lines."}
  h1={"Passport photo print sheet"}
  intro={"Choose how many copies and the paper size. Print at any photo shop."}
  steps={[{"name": "Add your file", "text": "Take a photo or choose one from your gallery. It stays on your device."}, {"name": "Adjust", "text": "Crop and set the size you need."}, {"name": "Download", "text": "Check the ticks, then download."}]}
/>
