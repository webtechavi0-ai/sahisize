---
/** T8 /tools/passport-photo-sheet (SPEC 5.2, P2). */
import Tool from '@/layouts/Tool.astro';
import ToolPhotoSheet from '@/islands/tools/ToolPhotoSheet';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { photoSheetCopy } from '@/components/tools/copy/more';
const lang = 'en';
const c = photoSheetCopy();
---

<Tool lang={lang} tool="passport-photo-sheet" path="/tools/passport-photo-sheet" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolPhotoSheet client:visible lang={lang} dict={toolDict(lang)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
