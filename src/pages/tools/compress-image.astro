---
/**
 * Route shell (Workstream C, Phase 2). Workstream F replaces the placeholder with
 * the tool island and the final copy in Phase 3.
 */
import Tool from '@/layouts/Tool.astro';
---

<Tool
  tool="compress-image"
  path="/tools/compress-image"
  title={"Compress Image to Any KB Online Free — Exact Size, No Upload"}
  description={"Compress a photo or signature to any target KB, with an optional minimum. Processed on your device, never uploaded."}
  h1={"Compress image to any KB"}
  intro={"Pick a target size in KB. The result lands just under it, at the same pixel size if you want."}
  steps={[{"name": "Add your file", "text": "Take a photo or choose one from your gallery. It stays on your device."}, {"name": "Adjust", "text": "Crop and set the size you need."}, {"name": "Download", "text": "Check the ticks, then download."}]}
/>
