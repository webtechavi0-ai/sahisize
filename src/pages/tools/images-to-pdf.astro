---
/**
 * Route shell (Workstream C, Phase 2). Workstream F replaces the placeholder with
 * the tool island and the final copy in Phase 3.
 */
import Tool from '@/layouts/Tool.astro';
---

<Tool
  tool="images-to-pdf"
  path="/tools/images-to-pdf"
  title={"Images to PDF Under Any KB — Combine Certificates Free, No Upload"}
  description={"Combine up to 20 photos or scans into one PDF under your KB limit. A4 or original size. Runs on your device."}
  h1={"Images to PDF under a KB limit"}
  intro={"Add your certificate photos, reorder them and get one PDF under the size your form allows."}
  steps={[{"name": "Add your file", "text": "Take a photo or choose one from your gallery. It stays on your device."}, {"name": "Adjust", "text": "Crop and set the size you need."}, {"name": "Download", "text": "Check the ticks, then download."}]}
/>
