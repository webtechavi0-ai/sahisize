---
/** T7 /tools/compress-pdf-to-[n]kb, n in PDF_KB_TARGETS (keyword map "Tools: PDF"). Unique copy per n. */
import Tool from '@/layouts/Tool.astro';
import ToolCompressPdf from '@/islands/tools/ToolCompressPdf';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { compressPdfKbCopy } from '@/components/tools/copy/pdf-kb';
import { PDF_KB_TARGETS, compressPdfToKbPath } from '@/config/tools';

export function getStaticPaths() {
  return PDF_KB_TARGETS.map((n) => ({ params: { n: String(n) }, props: { n } }));
}
interface Props {
  n: number;
}
const { n } = Astro.props;
const lang = 'en';
const c = compressPdfKbCopy(n, lang);
---

<Tool lang={lang} tool="compress-pdf" path={compressPdfToKbPath(n)} title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolCompressPdf client:visible lang={lang} dict={toolDict(lang)} initialKB={n} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
