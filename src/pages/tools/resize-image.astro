---
/** T2 /tools/resize-image (SPEC 5.2). */
import Tool from '@/layouts/Tool.astro';
import ToolResize from '@/islands/tools/ToolResize';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { resizeCopy } from '@/components/tools/copy/resize-convert';
const lang = 'en';
const c = resizeCopy(lang);
---

<Tool lang={lang} tool="resize-image" path="/tools/resize-image" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolResize client:visible lang={lang} dict={toolDict(lang)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
