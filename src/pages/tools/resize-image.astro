---
/**
 * Route shell (Workstream C, Phase 2). Workstream F replaces the placeholder with
 * the tool island and the final copy in Phase 3.
 */
import Tool from '@/layouts/Tool.astro';
---

<Tool
  tool="resize-image"
  path="/tools/resize-image"
  title={"Resize Image in Pixels, cm or Inches with DPI — Free, No Upload"}
  description={"Resize a photo to exact pixels, centimetres, millimetres or inches at any DPI, with aspect lock. Runs on your device."}
  h1={"Resize image (px, cm, inches, DPI)"}
  intro={"Enter the size from your form in pixels, cm or inches. Lock the aspect ratio or set both sides."}
  steps={[{"name": "Add your file", "text": "Take a photo or choose one from your gallery. It stays on your device."}, {"name": "Adjust", "text": "Crop and set the size you need."}, {"name": "Download", "text": "Check the ticks, then download."}]}
/>
