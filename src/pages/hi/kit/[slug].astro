---
/** /hi/kit/[slug]: same 30 exams as /hi/exam/[slug]. */
import Kit from '@/layouts/Kit.astro';
import { getKitDocuments, getPreset, type ExamPreset } from '@/content/presets';
import { hindiExamSlugs } from '@/seo/hreflang';

export function getStaticPaths() {
  return hindiExamSlugs()
    .map((slug) => getPreset(slug)!)
    .filter((p) => getKitDocuments(p).length > 0)
    .map((preset) => ({ params: { slug: preset.slug }, props: { preset } }));
}
interface Props {
  preset: ExamPreset;
}
const { preset } = Astro.props;
---

<Kit lang="hi" preset={preset} />
