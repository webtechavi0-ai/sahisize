---
/** Hindi /hi/tools/increase-image-size-in-kb. */
import Tool from '@/layouts/Tool.astro';
import ToolIncrease from '@/islands/tools/ToolIncrease';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { increaseCopy } from '@/components/tools/copy/increase';
const lang = 'hi';
const c = increaseCopy(lang);
---

<Tool lang={lang} tool="increase-image-size-in-kb" path="/tools/increase-image-size-in-kb" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolIncrease client:visible lang={lang} dict={toolDict(lang)} initialMinKB={20} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
