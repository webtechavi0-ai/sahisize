---
/** Hindi T6 /hi/tools/jpg-to-pdf-under-300kb (keyword map "Tools: PDF"). hreflang pairs with the English page. */
import Tool from '@/layouts/Tool.astro';
import ToolImagesToPdf from '@/islands/tools/ToolImagesToPdf';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { jpgToPdfKbCopy } from '@/components/tools/copy/pdf-kb';
import { jpgToPdfUnderKbPath } from '@/config/tools';
const lang = 'hi';
const n = 300;
const c = jpgToPdfKbCopy(n, lang);
---

<Tool lang={lang} tool="images-to-pdf" path={jpgToPdfUnderKbPath(n)} title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolImagesToPdf client:visible lang={lang} dict={toolDict(lang)} initialKB={n} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
