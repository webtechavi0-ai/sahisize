---
/** Hindi /hi/tools/name-date-on-photo. */
import Tool from '@/layouts/Tool.astro';
import ToolNameDate from '@/islands/tools/ToolNameDate';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { nameDateExams } from '@/components/tools/name-date-server';
import { nameDateCopy } from '@/components/tools/copy/name-date';
const lang = 'hi';
const exams = nameDateExams(lang);
const c = nameDateCopy(lang, exams);
---

<Tool lang={lang} tool="name-date-on-photo" path="/tools/name-date-on-photo" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolNameDate client:visible lang={lang} dict={toolDict(lang)} options={exams.map((e) => e.option)} />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
