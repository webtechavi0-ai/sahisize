---
/** Hindi T1 /hi/tools/compress-image (provisional Hindi, G polishes). */
import Tool from '@/layouts/Tool.astro';
import ToolCompress from '@/islands/tools/ToolCompress';
import ToolContent from '@/components/tools/ToolContent.astro';
import { toolDict } from '@/components/tools/dict';
import { compressImageCopy } from '@/components/tools/copy/compress';
const lang = 'hi';
const c = compressImageCopy(lang);
---

<Tool lang={lang} tool="compress-image" path="/tools/compress-image" title={c.title} description={c.description} h1={c.h1} intro={c.intro} steps={c.steps} faq={c.faq}>
  <ToolCompress client:visible lang={lang} dict={toolDict(lang)} initialKB={50} askSize />
  <ToolContent slot="content" sections={c.sections} />
</Tool>
