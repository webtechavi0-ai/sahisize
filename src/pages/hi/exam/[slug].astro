---
/** /hi/exam/[slug]: top 30 exams (hi-top-exams.json ∩ published presets). */
import Exam from '@/layouts/Exam.astro';
import { getPreset, type ExamPreset } from '@/content/presets';
import { hindiExamSlugs } from '@/seo/hreflang';

export function getStaticPaths() {
  return hindiExamSlugs().map((slug) => ({ params: { slug }, props: { preset: getPreset(slug)! } }));
}
interface Props {
  preset: ExamPreset;
}
const { preset } = Astro.props;
---

<Exam lang="hi" preset={preset} />
