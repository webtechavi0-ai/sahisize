            {
              "text": " में चौड़ाई, ऊँचाई, min KB, max KB और DPI डालें।"
            }
          ]
        },
        {
          "content": [
            {
              "text": "सिर्फ पिक्सल बदलने हैं तो "
            },
            {
              "text": "Resize Image",
              "href": "/hi/tools/resize-image"
            },
            {
              "text": ", सिर्फ KB तो "
            },
            {
              "text": "Compress Image",
              "href": "/hi/tools/compress-image"
            },
            {
              "text": "।"
            }
          ]
