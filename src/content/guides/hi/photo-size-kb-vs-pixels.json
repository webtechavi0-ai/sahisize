            }
          ]
        ],
        [
          [
            {
              "text": "5 × 6 सेमी फोटो (UPPSC)"
            }
          ],
          [
            {
              "text": "200"
            }
          ],
          [
            {
              "text": "394 × 472"
            }
          ]
        ]
