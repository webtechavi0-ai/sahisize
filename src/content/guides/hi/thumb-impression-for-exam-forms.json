              "href": "/hi/exam/htet"
            }
          ],
          [
            {
              "text": "अंगूठा"
            }
          ],
          [
            {
              "text": "10–50 KB"
            }
          ]
        ],
        [
          [
            {
              "text": "DSSSB",
              "href": "/hi/exam/dsssb"
            }
          ],
          [
            {
              "text": "बायाँ और दायाँ अंगूठा, "
            },
            {
              "text": "अलग-अलग फाइल",
              "bold": true
            }
          ],
          [
            {
              "text": "हर एक 40 KB तक"
            }
          ]
        ],
        [
          [
            {
