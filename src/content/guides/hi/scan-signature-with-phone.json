              "href": "/hi/exam/neet-ug"
            },
            {
              "text": ", JEE Main"
            }
          ],
          [
            {
              "text": "सिर्फ KB"
            }
          ],
          [
            {
              "text": "10–100 KB"
            }
          ]
        ],
        [
          [
            {
              "text": "CUET UG",
              "href": "/hi/exam/cuet-ug"
            },
            {
              "text": ", UGC NET"
            }
          ],
          [
            {
              "text": "सिर्फ KB"
            }
          ],
          [
            {
              "text": "10–50 KB"
            }
          ]
        ],
        [
          [
            {
              "text": "UPSC CSE",
              "href": "/hi/exam/upsc-cse"
            }
          ],
          [
            {
              "text": "350–500 px चौकोर (3 सिग्नेचर)"
            }
          ],
          [
            {
              "text": "20–100 KB"
            }
          ]
        ],
        [
          [
            {
              "text": "CTET",
              "href": "/hi/exam/ctet"
            }
          ],
          [
            {
              "text": "3.5 × 1.5 सेमी"
            }
          ],
          [
            {
              "text": "3–30 KB"
            }
          ]
        ]
      ]
    },
    {
      "type": "p",
      "content": [
        {
          "text": "SSC सिर्फ सेंटीमीटर बताता है। 200 DPI पर 6.0 × 2.0 सेमी करीब 472 × 157 पिक्सल बनता है — SahiSize डिफॉल्ट में यही इस्तेमाल करता है। यह हिसाब कैसे निकलता है, यहाँ पढ़ें: "
        },
        {
          "text": "KB बनाम पिक्सल",
          "href": "/hi/guides/photo-size-kb-vs-pixels"
        },
        {
          "text": "।"
        }
      ]
    },
    {
      "type": "h2",
      "content": [
        {
          "text": "RRB की दिक्कत: सिग्नेचर KB में बहुत छोटा"
        }
      ]
    },
    {
      "type": "p",
      "content": [
        {
          "text": "RRB को 30–49 KB चाहिए। साफ काले-सफेद सिग्नेचर में इतनी कम डिटेल होती है कि full quality पर भी वह अक्सर सिर्फ 10–15 KB का बनता है। फिर पोर्टल बोलता है फाइल बहुत छोटी है।"
        }
      ]
    },
    {
      "type": "p",
      "content": [
        {
          "text": "खुद noise डालकर जुगाड़ करने की ज़रूरत नहीं। SahiSize का RRB प्रीसेट यह संभाल लेता है: पहले सबसे ऊँची quality, फिर तय रेंज में बड़ा पिक्सल साइज़, और ज़रूरत पड़े तो ही बहुत हल्का grain या सफेद padding। सिग्नेचर वैसा ही दिखता है, और फाइल 30 KB तक पहुँच जाती है।"
        }
      ]
    },
    {
      "type": "h2",
      "content": [
        {
          "text": "आम गलतियाँ"
        }
      ]
    },
    {
      "type": "ul",
      "items": [
        {
          "content": [
            {
              "text": "लाइन वाले कागज़ पर साइन।",
              "bold": true
            },
            {
              "text": " लाइनें इमेज में आ जाती हैं। सादा कागज़ लें।"
            }
          ]
        },
        {
          "content": [
            {
              "text": "स्क्रीन की फोटो।",
              "bold": true
            },
            {
              "text": " किसी दूसरी स्क्रीन पर दिख रहे सिग्नेचर की फोटो कभी न लें; वह धुंधली और धारीदार बनती है।"
            }
          ]
        },
        {
          "content": [
            {
              "text": "पुरानी सिग्नेचर इमेज।",
              "bold": true
            },
            {
              "text": " तीन साल पहले अलग तरह से साइन करते थे, तो नया बनाएँ।"
            }
          ]
        },
        {
          "content": [
            {
              "text": "गलत दिशा।",
              "bold": true
            },
            {
              "text": " ज़्यादातर एग्ज़ाम में इमेज landscape (चौड़ी ज़्यादा, ऊँची कम) होनी चाहिए; UPSC में चौकोर।"
            }
          ]
        },
        {
          "content": [
            {
              "text": "WhatsApp से सेव करना।",
              "bold": true
            },
            {
              "text": " WhatsApp इमेज को दोबारा compress कर देता है। केबल से ट्रांसफर करें या ओरिजिनल फाइल लें।"
            }
          ]
        }
      ]
    },
    {
      "type": "h2",
      "content": [
        {
          "text": "अक्सर पूछे जाने वाले सवाल"
        }
      ]
    },
    {
      "type": "h3",
