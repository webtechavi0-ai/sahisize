          "text": "how to make a thumb impression",
          "href": "/guides/thumb-impression-for-exam-forms"
        },
        {
          "text": " and the "
        },
        {
          "text": "exam form checklist",
          "href": "/guides/exam-form-checklist"
        },
        {
          "text": "."
        }
      ]
