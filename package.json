{
  "name": "sahisize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SahiSize: exam form photo, signature and document resizer. Right size, first time.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && next dev",
    "build": "node scripts/copy-wasm.mjs && next build",
    "start": "serve out -l 3003",
    "postinstall": "node scripts/copy-wasm.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lhci": "lhci autorun",
    "presets:check": "tsx scripts/presets-check.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "budgets": "tsx scripts/check-budgets.ts",
    "links": "tsx scripts/check-links.ts",
    "icons": "pwa-assets-generator",
    "contrast": "tsx scripts/contrast-check.ts"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve": "^14.2.6",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "~1.0.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "gray-matter": "^4.0.3",
    "linkinator": "^8.1.0",
    "marked": "^18.1.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "satori": "^0.63.2",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
