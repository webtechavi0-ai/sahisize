{
  "name": "sahisize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SahiSize: exam form photo, signature and document resizer. Right size, first time.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "node scripts/copy-wasm.mjs && next dev --port 3003",
    "build": "node scripts/copy-wasm.mjs && next build",
    "postbuild": "node scripts/prepare-standalone.mjs && npm run check:no-export",
    "start": "PORT=${PORT:-3003} node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "presets:check": "tsx scripts/presets-check.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "check:contrast": "tsx scripts/contrast-check.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "lhci": "lhci autorun",
    "verify:static": "npm run lint && npm run typecheck && npm run test && npm run presets:check && npm run i18n:check && npm run check:contrast",
    "verify": "npm run verify:static && npm run build && npm run check:budgets && npm run check:routes",
    "check:no-export": "node -e \"if (require('fs').existsSync('out')) { console.error('ERROR: out/ exists. Static export is not allowed; the app uses output: standalone.'); process.exit(1) }\""
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "server-only": "^0.0.1",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "linkinator": "^8.1.0",
    "node-html-parser": "^9.0.6",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
