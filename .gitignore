# Dependencies
node_modules/

# Build output (the app is a Node server: output 'standalone' -> .next/standalone)
.next/
# Static export is not allowed; out/ must never exist. Ignored as a backstop.
out/
# Leftovers from the old Astro setup
dist/
build/
.astro/

# Old codec copies (unused: the engine's .wasm files are bundled under /_next/static/media)
public/wasm/

# GPT Image source PNGs (~45 MB, local only). The site ships the optimized files in public/img;
# the per-slot .json provenance (model, prompt hash) next to them is committed. Re-running
# `npm run images:optimize` needs these PNGs, so keep a backup outside git.
assets/images/source/*.png

# Generated by tooling
next-env.d.ts
*.tsbuildinfo
coverage/
test-results/
.cache/
.turbo/
.vercel/

# Environment and secrets
.env
.env.*
!.env.example
*.pem

# Logs
*.log
npm-debug.log*

# OS and editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json
